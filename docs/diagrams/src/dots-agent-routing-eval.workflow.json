    { "id": "expected", "lane": "remote", "col": 2, "type": "security", "label": "Expected Cost", "sublabel": "cost / P(ok)", "width": 132 },
    { "id": "budget", "lane": "remote", "col": 3, "type": "security", "label": "Budget Reserve", "sublabel": "hard cap", "width": 132 },
