  "cards": [
    {
      "dot": "emerald",
      "title": "Local first",
      "items": [
        "Local Pi attempts the task before any billable consult",
        "Verification is a local proof, not an LLM claim"
      ]
    },
    {
      "dot": "cyan",
      "title": "Expected cost",
      "items": [
        "Wilson floor uses eval evidence for the task class",
        "Route on cost / P(success), not cheapest request alone"
      ]
    },
    {
      "dot": "rose",
      "title": "Budget honesty",
      "items": [
        "Reserve before LiteLLM; settle after response",
        "Connection refused never fabricates spend"
      ]
    }
