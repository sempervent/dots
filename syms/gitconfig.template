# ~/.gitconfig.template - Git Configuration Template
# https://github.com/sempervent/dotfiles
# 
# NOTE: This is a TEMPLATE. Copy to ~/.gitconfig and customize:
#   cp ~/.gitconfig.template ~/.gitconfig
#   vim ~/.gitconfig
#
# Or use: git config --global user.name "Your Name"
#         git config --global user.email "your.email@example.com"

[user]
	name = Joshua N. Grant
	email = jngrant@live.com
	# signingkey = YOUR_GPG_KEY_ID

[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	# autocrlf = true  # For Windows
	filemode = true
	ignorecase = false
	
[init]
	defaultBranch = main

[push]
	default = simple
	followTags = true

[pull]
	rebase = false
	# rebase = true  # If you prefer rebase

[merge]
	tool = vimdiff
	conflictstyle = diff3

[diff]
	tool = vimdiff
	colorMoved = default
	algorithm = patience
	
[difftool]
	prompt = false

[status]
	submodulesummary = true
	branch = true
	short = false

[log]
	date = relative
	decorate = short
	abbrevCommit = true

[color]
	ui = auto
	
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	# Status
	st = status
	stat = status
	
	# Branch
	br = branch
	co = checkout
	cb = checkout -b
	
	# Commit
	ci = commit
	amend = commit --amend
	amendf = commit --amend --no-edit
	
	# Log
	l = log --oneline --graph --decorate --all
	ll = log --oneline --graph --decorate --all -20
	ls = log --oneline --decorate
	lg = log --oneline --graph --decorate --all --pretty=format:'%C(yellow)%h%Creset -%C(red)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset'
	
	# Diff
	d = diff
	dc = diff --cached
	ds = diff --staged
	
	# Fetch/Pull
	f = fetch
	p = pull
	pr = pull --rebase
	
	# Push
	ps = push
	psu = push -u origin HEAD
	
	# Stash
	ss = stash save
	sp = stash pop
	sl = stash list
	
	# Reset
	unstage = reset HEAD --
	uncommit = reset --soft HEAD^
	
	# Clean
	cleanf = clean -fd
	
	# Submodule
	sub = submodule
	subu = submodule update --init --recursive
	
	# Misc
	unadd = reset HEAD
	who = blame
	last = log -1 HEAD
	visual = !vim
	edit = !vim
	
[rerere]
	enabled = true
	
[rerere "autoupdate"]
	autoupdate = true

[help]
	autocorrect = 1

# GPG Signing (if configured)
# [commit]
# 	gpgsign = true

# [tag]
# 	gpgsign = true

# GitHub CLI (if installed)
# [github]
# 	user = yourusername


