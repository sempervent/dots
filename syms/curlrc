# ~/.curlrc - curl Configuration
# https://github.com/sempervent/dotfiles

# Progress bar
progress-bar

# Continue on errors
continue-at = -

# Maximum time to wait
max-time = 30

# Retry on failure
retry = 3
retry-delay = 1

# Show errors
show-error

# Location for cookies
cookie-jar = ~/.cache/curl_cookies

# Location for cookies (write)
cookie = ~/.cache/curl_cookies

# User agent (can be customized)
# user-agent = "curl/7.x.x"

# Fail silently on HTTP errors
# fail
# fail-with-body

# Follow redirects
location
location-trusted

# SSL/TLS
# insecure
# cert = ~/.certs/cert.pem
# key = ~/.certs/key.pem

# Compress
# compress

# Quiet mode (uncomment to make curl quiet by default)
# silent


