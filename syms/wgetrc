# ~/.wgetrc - wget Configuration
# https://github.com/sempervent/dotfiles

# Progress bar
progress = bar

# Continue partial downloads
continue = on

# Retry on failure
tries = 3
timeout = 30

# Retry delay
wait = 1

# Recursive download settings
# recursive = on
# level = 5

# Output to current directory
# directory-prefix = .

# User agent
# user_agent = Wget/1.x.x

# Quiet mode (uncomment to make wget quiet)
# quiet = on

# Verbose output
# verbose = on

# Ignore robots.txt
# robots = off

# Cookie handling
# use_cookies = on
# cookies = on
# save_cookies = ~/.cache/wget_cookies
# load_cookies = ~/.cache/wget_cookies

# HTTPS/SSL
# check_certificate = off
# ca_certificate = /etc/ssl/certs/ca-certificates.crt


