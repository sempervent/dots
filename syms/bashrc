#!/usr/bin/env bash
# ~/.bashrc — Bash for servers, scripts, troubleshooting, and Zsh-less hosts
# https://github.com/sempervent/dots
#
# Architecture:
#   shell/  shared aliases, exports, functions, paths, tools
#   bash/   bash-only options, history, completion, prompt
#   distro/ platform hooks
#
# Does not assume Oh My Zsh. Keeps vi mode, custom prompt, and tmux workflow.

# Resolve this file and dots checkout {{{1
SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SOURCE}" ]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ ${SOURCE} != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"

# Prefer repo containing this bashrc (…/dots/syms → …/dots)
if [ -d "${DIR}/../shell" ]; then
  DOTS_DIR="$(cd "${DIR}/.." >/dev/null 2>&1 && pwd)"
else
  DOTS_DIR="${DOTS_DIR:-${HOME}/dots}"
fi
export DOTS_DIR
export DOTS_SHELL=bash
export SRC_DIR="${HOME}"
# 1}}}

# Non-interactive → stop early (before anything noisy) {{{1
case $- in
  *i*) ;;
  *) return ;;
esac
# 1}}}

# Shared layer {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/paths.sh" ] && . "${DOTS_DIR}/shell/paths.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/runtime.sh" ] && . "${DOTS_DIR}/shell/runtime.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/fnm.sh" ] && . "${DOTS_DIR}/shell/fnm.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/exports.sh" ] && . "${DOTS_DIR}/shell/exports.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/theme.sh" ] && . "${DOTS_DIR}/shell/theme.sh"
# 1}}}

# Bash modules {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/options.sh" ] && . "${DOTS_DIR}/bash/options.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/history.sh" ] && . "${DOTS_DIR}/bash/history.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/completion.sh" ] && . "${DOTS_DIR}/bash/completion.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/colors.sh" ] && . "${DOTS_DIR}/bash/colors.sh"
# 1}}}

# Shared aliases / functions {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/aliases.sh" ] && . "${DOTS_DIR}/shell/aliases.sh"
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/functions.sh" ] && . "${DOTS_DIR}/shell/functions.sh"
# Bash-only helpers (ffs, so)
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/bash_only.sh" ] && . "${DOTS_DIR}/bash/bash_only.sh"
# Upstream web helpers (wsearch); optional
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/web.sh" ] && . "${DOTS_DIR}/bash/web.sh"
# 1}}}

# Prompt last among bash modules so it owns PROMPT_COMMAND {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/bash/prompt.sh" ] && . "${DOTS_DIR}/bash/prompt.sh"
# 1}}}

# Modern tools {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/tools.sh" ] && . "${DOTS_DIR}/shell/tools.sh"
# 1}}}

# fzf — prefer official bash integration {{{1
if command -v fzf >/dev/null 2>&1; then
  if fzf --bash >/dev/null 2>&1; then
    # shellcheck disable=SC1090
    eval "$(fzf --bash)"
  elif [ -f "${HOME}/.fzf.bash" ]; then
    # shellcheck disable=SC1091
    . "${HOME}/.fzf.bash"
  fi
fi
# 1}}}

# Platform hooks {{{1
case "$(uname -s)" in
  Darwin)
    # shellcheck disable=SC1091
    [ -f "${DOTS_DIR}/distro/mac.sh" ] && . "${DOTS_DIR}/distro/mac.sh"
    ;;
  Linux)
    # shellcheck disable=SC1091
    [ -f "${DOTS_DIR}/distro/linux.sh" ] && . "${DOTS_DIR}/distro/linux.sh"
    if command -v whatdistro >/dev/null 2>&1 && [ "$(whatdistro)" = "Void Linux" ]; then
      # shellcheck disable=SC1091
      [ -f "${DOTS_DIR}/distro/void.sh" ] && . "${DOTS_DIR}/distro/void.sh"
    fi
    ;;
esac
# 1}}}

# Version managers {{{1
# Node: fnm only (DOTS policy). ~/.nvm data is never deleted; NVM is not sourced.
# shellcheck disable=SC1091
[ -f "${HOME}/.cargo/env" ] && . "${HOME}/.cargo/env"
# 1}}}

# Multiplexer auto-start (tmux | herdr | none) {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/tmux.sh" ] && . "${DOTS_DIR}/shell/tmux.sh"
if declare -F dots_maybe_start_multiplexer >/dev/null 2>&1; then
  dots_maybe_start_multiplexer
fi
# 1}}}

# Greeting {{{1
# shellcheck disable=SC1091
[ -f "${DOTS_DIR}/shell/greeting.sh" ] && . "${DOTS_DIR}/shell/greeting.sh"
if [ -z "${TMUX:-}" ] || [ -n "${SSH_TTY:-}" ]; then
  if declare -F dots_greeting >/dev/null 2>&1; then
    dots_greeting
  fi
fi
# 1}}}

# Optional per-machine overrides (canonical: ~/.config/dots/local.sh)
# shellcheck disable=SC1091
[ -f "${HOME}/.config/dots/local.sh" ] && . "${HOME}/.config/dots/local.sh"
# Compatibility: legacy bash-only local file
# shellcheck disable=SC1091
[ -f "${HOME}/.bash_aliases" ] && . "${HOME}/.bash_aliases"
# shellcheck disable=SC1091
[ -f "${HOME}/.bashrc.local" ] && . "${HOME}/.bashrc.local"
