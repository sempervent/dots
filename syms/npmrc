# ~/.npmrc - npm Configuration (DOTS)
# https://github.com/sempervent/dots
#
# Node is managed by fnm (not a custom global prefix).
# Previous prefix=${HOME}/.npm-packages stranded globals when the dir was missing.
# Global packages now install into the active fnm Node prefix.

# Cache location
cache=${HOME}/.npm/.cache

# Registry
registry=https://registry.npmjs.org/

# Save exact versions by default
save-exact=false
save-prefix=^

# Color output
color=always

# Progress bar
progress=true

# Logging
loglevel=notice

# Security
audit=true
audit-level=moderate

# Engine strictness
engine-strict=false

# Fund messages
fund=false

# Update notifications
update-notifier=true
