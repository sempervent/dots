# PATH additions
import os
home = os.path.expanduser('~')
path_entries = [
    os.path.join(home, 'scripts'),
    os.path.join(home, '.local', 'bin'),
]

if 'JAVA_HOME' in os.environ:
    path_entries.append(os.path.join(os.environ['JAVA_HOME'], 'bin'))

for entry in path_entries:
    if os.path.exists(entry) and entry not in $PATH:
        $PATH.insert(0, entry)

# macOS Homebrew
if $OS == 'Mac':
    if os.path.exists('/opt/homebrew'):
        $PATH.insert(0, '/opt/homebrew/bin')
    elif os.path.exists('/usr/local/Homebrew'):
        $PATH.insert(0, '/usr/local/bin')
