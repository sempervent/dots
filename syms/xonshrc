# Python functions (xonsh allows mixing Python and shell) {{{1
def mkcd(path):
    """Make directory and cd into it"""
    import os
    os.makedirs(path, exist_ok=True)
    os.chdir(path)

def extract(archive):
    """Extract various archive formats"""
    import os
    if not os.path.exists(archive):
        print(f"'{archive}' is not a valid file.")
        return
    
    if archive.endswith('.tar.bz2'):
        $(tar xvjf @(archive))
    elif archive.endswith('.tar.gz'):
        $(tar xzvf @(archive))
    elif archive.endswith('.bz2'):
        $(bunzip2 @(archive))
    elif archive.endswith('.rar'):
        $(unrar x @(archive))
    elif archive.endswith('.gz'):
        $(gunzip @(archive))
    elif archive.endswith('.tar'):
        $(tar xvf @(archive))
    elif archive.endswith('.tbz2'):
        $(tar xvjf @(archive))
    elif archive.endswith('.tgz'):
        $(tar xzvf @(archive))
    elif archive.endswith('.zip'):
        $(unzip @(archive))
    elif archive.endswith('.Z'):
        $(uncompress @(archive))
    elif archive.endswith('.7z'):
        $(7z x @(archive))
    else:
        print(f"don't know how to extract '{archive}' ...")

def file_count():
    """Count files in current directory"""
    import subprocess
    result = subprocess.run(['ls', '-1'], capture_output=True, text=True)
    return len([f for f in result.stdout.strip().split('\n') if f])

def my_ip():
    """Get public IP address"""
    import requests
    try:
        return requests.get('http://ifconfig.me', timeout=5).text.strip()
    except:
        try:
            return requests.get('http://ifconfig.co', timeout=5).text.strip()
        except:
            return "Unable to get IP"

def weather():
    """Get weather information"""
    import requests
    try:
        return requests.get('http://wttr.in', timeout=5).text
    except:
        return "Weather service unavailable"

def whatdistro():
    """Detect operating system distribution"""
    import platform
    if $OS == 'Mac':
        try:
            import subprocess
            result = subprocess.run(['sw_vers', '-productName'], capture_output=True, text=True)
            return result.stdout.strip()
        except:
            return "macOS"
    elif os.path.exists('/etc/os-release'):
        with open('/etc/os-release') as f:
            for line in f:
                if line.startswith('PRETTY_NAME'):
                    return line.split('=')[1].strip('"\n')
    return platform.system()

def f(pattern):
    """Quick file search"""
    import os
    import subprocess
    result = subprocess.run(['find', '.', '-name', f'*{pattern}*'], capture_output=True, text=True)
    return result.stdout

def d(pattern):
    """Quick directory search"""
    import subprocess
    result = subprocess.run(['find', '.', '-type', 'd', '-name', f'*{pattern}*'], capture_output=True, text=True)
    return result.stdout

# Docker functions {{{2
def dco(*args):
    """Docker compose wrapper that auto-detects docker-compose or docker compose"""
    import subprocess
    import shutil
    
    # Check for docker-compose command
    if shutil.which('docker-compose'):
        cmd = ['docker-compose'] + list(args)
    else:
        # Try docker compose
        result = subprocess.run(['docker', 'compose', 'version'], 
                              capture_output=True, text=True, timeout=2)
        if result.returncode == 0:
            cmd = ['docker', 'compose'] + list(args)
        else:
            print("Error: Neither 'docker-compose' nor 'docker compose' found")
            return 1
    
    subprocess.run(cmd)

def dcud(*args):
    """Docker compose down and up -d with auto-detection"""
    import subprocess
    import shutil
    
    # Check for docker-compose command
    if shutil.which('docker-compose'):
        subprocess.run(['docker-compose', 'down'])
        subprocess.run(['docker-compose', 'up', '-d'] + list(args))
    else:
        # Try docker compose
        result = subprocess.run(['docker', 'compose', 'version'], 
                              capture_output=True, text=True, timeout=2)
        if result.returncode == 0:
            subprocess.run(['docker', 'compose', 'down'])
            subprocess.run(['docker', 'compose', 'up', '-d'] + list(args))
        else:
            print("Error: Neither 'docker-compose' nor 'docker compose' found")
            return 1
