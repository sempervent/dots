# Detect OS
import platform
if platform.system() == 'Darwin':
    $OS = 'Mac'
elif 'CYGWIN' in platform.system() or 'MSYS' in platform.system() or 'MINGW' in platform.system():
    $OS = 'Win'
else:
    $OS = 'Nix'
