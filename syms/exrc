"~/.exrc - Minimal Vi Configuration
" Minimal vi/vim settings for systems with limited resources or compatibility
" This file is read by both vi and vim when in compatible mode

set nocompatible
set showmode
set showcmd
set autoindent
set smartindent
set number
set hlsearch
set incsearch
set ignorecase
set smartcase
set tabstop=4
set shiftwidth=4
set expandtab
set background=dark
syntax on

" Basic key mappings
map <F1> :help<CR>
map <F2> :w<CR>
map <F3> :q<CR>
map <F4> :wq<CR>

" Better escape
imap jj <ESC>

" Better movement
noremap j gj
noremap k gk


