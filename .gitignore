# Ignore private / generated / editor noise

.secrets/
secrets/
*.secret
*.pem
.env
.env.*

.old_dots/

.DS_Store
*.swp
*.swo
*~

.idea/
.vscode/

# Accidental local AI/runtime drops (do not ignore generic config.yaml)
.hermes/
.ollama/
**/auth.json
**/herdr.log
**/herdr-client.log
**/herdr-server.log
