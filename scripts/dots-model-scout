#!/usr/bin/env bash
# Launch dots-model-scout MCP (stdio).
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
	SCRIPT_PATH="$(realpath "${SCRIPT_PATH}")"
elif [[ -L ${SCRIPT_PATH} ]]; then
	SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
fi
DOTS_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
PROJECT_DIR="${DOTS_DIR}/tools/dots_agent"
export DOTS_DIR

if ! command -v uv >/dev/null 2>&1; then
	echo "Error: uv required for dots-model-scout" >&2
	exit 1
fi

exec uv run --directory "${PROJECT_DIR}" --python-preference system \
	python -m dots_agent.scout.mcp_server
