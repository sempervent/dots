#!/usr/bin/env bash
# Launch DOTS agent harness CLI.
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
	SCRIPT_PATH="$(realpath "${SCRIPT_PATH}")"
elif [[ -L ${SCRIPT_PATH} ]]; then
	SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
fi
DOTS_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
PROJECT_DIR="${DOTS_DIR}/tools/dots_agent"
export DOTS_DIR

if ! command -v uv >/dev/null 2>&1; then
	echo "Error: uv is required for dots-agent." >&2
	exit 1
fi

if [[ ! -d ${PROJECT_DIR}/.venv ]]; then
	uv sync --directory "${PROJECT_DIR}" --python-preference system || {
		echo "Error: uv sync failed for tools/dots_agent" >&2
		exit 1
	}
fi

exec uv run --directory "${PROJECT_DIR}" --python-preference system --frozen \
	python -m dots_agent "$@"
