#!/usr/bin/env bash
# cursor-agent-run — thin DOTS wrapper around official Cursor `agent --print`
# Usage:
#   cursor-agent-run run --dir /path/to/repo --prompt "Inspect this repository."
set -euo pipefail

DOTS_DIR="${DOTS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
TELEMETRY_BIN="${DOTS_DIR}/scripts/agent-telemetry"

usage() {
  cat <<'EOF'
Usage: cursor-agent-run run [options]

Options:
  --dir <path>       Workspace directory (default: cwd)
  --prompt <text>    Prompt (required)
  --mode <mode>      plan | ask (optional; omit for default agent mode)
  --model <model>    Model id (optional)
  --output-format f  text | json | stream-json (default: text)
  -h, --help         Show help

Requires Cursor Agent CLI (`agent`) from: ./setup.sh --with cursor
EOF
}

CMD="${1:-}"
[[ "${CMD}" == "-h" || "${CMD}" == "--help" ]] && { usage; exit 0; }
[[ "${CMD}" == "run" ]] || { echo "Error: expected 'run'" >&2; usage >&2; exit 1; }
shift || true

DIR_ARG=""
PROMPT=""
MODE=""
MODEL=""
OUTFMT="text"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) DIR_ARG="${2:-}"; shift 2 ;;
    --prompt) PROMPT="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    --output-format) OUTFMT="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Error: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -z "${PROMPT}" ]]; then
  echo "Error: --prompt is required" >&2
  exit 1
fi

if ! command -v agent >/dev/null 2>&1; then
  echo "Error: 'agent' (Cursor CLI) not found. Install: ./setup.sh --with cursor" >&2
  exit 1
fi

# Telemetry start (never stores prompt; never aborts task)
TELE_ID=""
if [[ "${DOTS_TELEMETRY:-1}" != "0" ]] && [[ -x "${TELEMETRY_BIN}" ]]; then
  TELE_ID="$("${TELEMETRY_BIN}" record-start \
    --backend cursor \
    --kind coding-cursor \
    --label "cursor agent run" \
    --model "${MODEL:-}" \
    --cwd "${DIR_ARG:-$(pwd)}" \
    --tool cursor-agent-run \
    --local-or-cloud cloud 2>/dev/null || true)"
fi

args=(-p --print --output-format "${OUTFMT}" --trust)
[[ -n "${DIR_ARG}" ]] && args+=(--workspace "${DIR_ARG}")
[[ -n "${MODE}" ]] && args+=(--mode "${MODE}")
[[ -n "${MODEL}" ]] && args+=(--model "${MODEL}")
args+=("${PROMPT}")

set +e
agent "${args[@]}"
rc=$?
set -e

if [[ -n "${TELE_ID}" ]] && [[ -x "${TELEMETRY_BIN}" ]]; then
  if [[ "${rc}" -eq 0 ]]; then
    "${TELEMETRY_BIN}" record-finish --id "${TELE_ID}" --success true --exit-code 0 --model "${MODEL:-}" >/dev/null 2>&1 || true
  else
    "${TELEMETRY_BIN}" record-finish --id "${TELE_ID}" --success false --exit-code "${rc}" --model "${MODEL:-}" >/dev/null 2>&1 || true
  fi
fi

exit "${rc}"
