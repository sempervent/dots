#!/usr/bin/env bash
# Launch DOTS interactive help (Textual TUI) for the current machine.
#
# Stable entrypoint (after setup): ~/.local/bin/dots-help
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
	SCRIPT_PATH="$(realpath "${SCRIPT_PATH}")"
elif [[ -L ${SCRIPT_PATH} ]]; then
	SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
fi
DOTS_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
PROJECT_DIR="${DOTS_DIR}/tools/dots_help"

export DOTS_DIR

if ! command -v uv >/dev/null 2>&1; then
	echo "Error: uv is required for dots-help." >&2
	echo "       Install uv (core/modern package groups), then re-run ./setup.sh" >&2
	exit 1
fi

if [[ ! -f ${PROJECT_DIR}/pyproject.toml ]]; then
	echo "Error: missing ${PROJECT_DIR}/pyproject.toml" >&2
	exit 1
fi

if [[ ! -d ${PROJECT_DIR}/.venv ]]; then
	uv sync --directory "${PROJECT_DIR}" --python-preference system || {
		echo "Error: uv sync failed for tools/dots_help" >&2
		exit 1
	}
fi

exec uv run --directory "${PROJECT_DIR}" --python-preference system --frozen \
	python -m dots_help "$@"
