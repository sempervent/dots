    'restore:Restore a snapshot (creates a safety snapshot first).'
    'profile:Create, preview, or switch machine profiles.'
    'models:Local model plan, discovery, and pull workflows.'
    'check:Machine health plus local CI, docs, security, container…'
    'update:git pull the DOTS repo and optionally reapply setup.'
    'help:Interactive Textual help (dots-help) for this machine.'
    'shell:Inspect shell, prompt, and keybinding ownership.'
    'completion:DOTS CLI completion and fzf-tab diagnostics.'
  )
  topics=(
    'overview:Overview'
    'getting-started:Getting Started'
    'shell:Shell & Prompt'
    'completion:Fuzzy Completion'
    'keybindings:Keybindings'
    'profiles:Profiles'
    'components:Components'
    'supergroups:Supergroups'
    'packages:Packages'
    'ai:AI'
    'models:Models'
    'lsp:Language Servers'
    'skills:Skills'
    'backup:Backup & Restore'
    'data:Data tooling'
    'agent:Agent Harness'
    'network:Network tooling'
    'agent-security:Agent Security'
    'hardware:Hardware tooling'
    'infra:Infrastructure tooling'
    'docs-tooling:Documentation tooling'
    'geo:Geospatial tooling'
    'diagnostics:Diagnostics'
    'update:Update / Maintenance'
    'commands:Commands'
    'files:Files & Configuration'
    'agent-evals:Agent Evaluations'
    'agent-routing:Model Routing'
    'agent-teams:Agent Teams'
  )
  selectors=(
    'ai:AI applications'
    'herdr:Herdr'
    'hermes:Hermes'
    'ollama:Ollama'
    'llamacpp:llama.cpp'
    'archify:Archify'
    'skills:Engineering skills'
    'ai-skills:AI skills'
    'drawthings:Draw Things'
    'opencode:OpenCode'
    'codex:Codex'
    'cursor:Cursor'
    'fluidvoice:FluidVoice'
    'images:Images toolkit'
    'tex:TeX'
    'mactools:macOS tools'
    'orbstack:OrbStack'
    'mitmproxy:mitmproxy'
    'syncthing:Syncthing'
    'lsp:Language servers'
    'ai-server:AI inference server'
    'pi:Pi Coding Agent'
    'litellm:LiteLLM Gateway'
    'agent-sandbox:Agent Sandbox'
    'openrig:OpenRig'
  )
  groups=(
    'core:Portable essentials'
    'modern:Shared ergonomic CLI + Git evolution / structur…'
    'workstation:Desktop-user tools (not headless)'
    'infra:Docker/Helm/Terraform + IaC engineering CLIs (i…'
    'media:Image / video processing'
    'gui:macOS GUI / fonts'
    'server:Headless extras'
    'dev:Local CI / lint / docs validation / Rust ergono…'
    'security:Secrets / SBOM / signing / YubiKey / host-inspe…'
    'network:Network / remote CLIs (install-only; no scans,…'
    'hardware:Storage / bus / serial diagnostics (install-onl…'
    'data:PostgreSQL inspection + tabular / analytical CL…'
    'backup:Backup / recovery CLIs (install-only; no repo i…'
    'geo:Geospatial CLI tooling (OSM / tiles / geometry;…'
    'containers:OCI / container operator CLIs (install-only; no…'
    'k8s:Kubernetes / GitOps operator CLIs (install-only…'
    'docs:Technical documentation / publishing CLIs (inst…'
  )
  profiles=('base' 'home' 'work' 'server' 'all')
  providers=('ollama' 'llamacpp' 'drawthings' 'fluidvoice' 'all')
  tiers=('auto' 'minimal' 'balanced' 'large' 'max')
  lsp_subs=('status' 'install' 'check' 'list')
  model_subs=('discover' 'pull' 'plan' '--list')
  shell_subs=('status' 'keys' 'startup')
  completion_subs=('status' 'paths')
  pkg_subs=('groups' 'group' 'plan' 'status' 'explain' 'outdated' 'upgrade' 'adopt' 'help')
  component_subs=('list' 'active' 'show' 'help')
  ai_subs=('status' 'doctor' 'up' 'down' 'help')
