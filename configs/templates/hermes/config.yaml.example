# Example Hermes config (NON-SECRET documentation only).
# Do NOT copy over an existing ~/.hermes/config.yaml automatically.
#
# Hermes is user-owned. Install CLI via: ./setup.sh --with hermes
# (Homebrew formula hermes-agent; macOS also gets hermes-desktop cask.)
#
# Agent skills (e.g. Archify):
#   ./setup.sh --with archify
# installs globally via `npx skills add … -g` into ~/.agents/skills/.
# The skills CLI also links into ~/.hermes/skills/<name>. Hermes lists these
# as local skills (`hermes skills list`). No manual symlink from dots.
#
# Draw Things (image TOOL, not a chat model):
#   ./setup.sh --with drawthings
# registers mcp_servers.drawthings → scripts/drawthings-mcp (CLI bridge).
# Images land in ~/Pictures/AI/DrawThings/ by default.
#
# Local Ollama example (OpenAI-compatible endpoint):
#
# model:
#   provider: ollama-launch
#   default: gemma4
#   base_url: http://127.0.0.1:11434/v1
#
# providers:
#   ollama-launch:
#     name: Ollama
#     api: http://127.0.0.1:11434/v1
#     default_model: gemma4
#     models:
#       - gemma4
#       - qwen3.5:latest
#
# Prefer `hermes model` / `hermes setup` / `hermes config` interactively.
# Secrets belong in ~/.hermes/.env — never in git.
