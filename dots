#!/usr/bin/env bash
# dots — unified human-facing entrypoint for sempervent/dots
#
# Orchestrates existing subsystems; does not duplicate install/model logic.
# Pure-Bash UI (no gum/dialog/fzf required).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

DOTS_APPLY_STARTED=0
dots_on_interrupt() {
	if [[ ${DOTS_APPLY_STARTED} -eq 1 ]]; then
		echo "" >&2
		echo "Setup interrupted." >&2
		echo "Re-run ./dots; operations are idempotent." >&2
	else
		echo "" >&2
		echo "No changes made." >&2
	fi
	exit 130
}
trap dots_on_interrupt INT

# shellcheck source=helpers/ui.sh
source "${DIR}/helpers/ui.sh"
# shellcheck source=helpers/state.sh
source "${DIR}/helpers/state.sh"
# shellcheck source=helpers/backup.sh
source "${DIR}/helpers/backup.sh"
# shellcheck source=helpers/wizard.sh
source "${DIR}/helpers/wizard.sh"
# shellcheck source=helpers/packages.sh
source "${DIR}/helpers/packages.sh"
# shellcheck source=helpers/package_state.sh
source "${DIR}/helpers/package_state.sh"
# shellcheck source=helpers/cask_apps.sh
source "${DIR}/helpers/cask_apps.sh"

dots_usage() {
	cat <<EOF
DOTS — machine environment manager  (v$(dots_version))

Usage:
  ./dots                     interactive setup
  ./dots setup               setup / reconfigure
  ./dots status              current state (read-only)
  ./dots packages            package ownership / drift
  ./dots packages status     full package audit
  ./dots packages outdated   outdated managed packages
  ./dots packages upgrade    upgrade DOTS-managed packages
  ./dots packages adopt …    suggest Brewfile declaration (no auto-edit)
  ./dots backup [--name N]   snapshot managed targets
  ./dots backups             list snapshots
  ./dots restore [ID]        restore a snapshot
  ./dots profile             profile management
  ./dots models              local model management
  ./dots check               verify machine
  ./dots update              update DOTS repo + reapply
  ./dots help                this help
  ./dots --version

Automation / expert scripts (still supported):
  ./bootstrap.sh   ./setup.sh   ./configure.sh
  ./scripts/pull_models.sh   ./scripts/check.sh
EOF
}

dots_cmd_status() {
	dots_ui_header "DOTS Status"
	echo ""
	echo "Version:"
	echo "  $(dots_version)"
	echo ""

	local profile="(none)" profile_file="" mux="(unknown)"
	if dots_state_load_active 2>/dev/null; then
		profile="${DOTS_ACTIVE_PROFILE:-unknown}"
		profile_file="${DOTS_ACTIVE_PROFILE_FILE:-}"
	fi
	echo "Profile:"
	echo "  ${profile}"
	[[ -n ${profile_file} ]] && echo "  file: ${profile_file}"

	if [[ -f "$(dots_runtime_env_file)" ]]; then
		# shellcheck disable=SC1090
		source "$(dots_runtime_env_file)" 2>/dev/null || true
		mux="${DOTS_MULTIPLEXER:-tmux}"
		echo ""
		echo "Packages:"
		echo "  groups: ${DOTS_PACKAGE_GROUPS:-(see profile)}"
		# Concise drift (fast mode skips brew outdated). Never abort status.
		if ! command -v "${DOTS_BREW_BIN:-brew}" >/dev/null 2>&1; then
			echo "  Homebrew unavailable"
		elif declare -F dots_pkg_status_report >/dev/null 2>&1; then
			DOTS_WITH_COMPONENTS=()
			if [[ -n ${DOTS_ACTIVE_COMPONENTS:-} ]]; then
				# shellcheck disable=SC2206
				DOTS_WITH_COMPONENTS=(${DOTS_ACTIVE_COMPONENTS})
			fi
			declare -F dots_resolve_package_groups >/dev/null 2>&1 &&
				dots_resolve_package_groups 2>/dev/null || true
			# quiet=1 fast=1 — skip outdated queries to keep status snappy
			if dots_pkg_status_report 1 1 2>/dev/null; then
				local drift_bits=()
				[[ ${DOTS_PKG_COUNT_EXTERNAL:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_EXTERNAL} external")
				[[ ${DOTS_PKG_COUNT_UNDECLARED:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_UNDECLARED} undeclared")
				[[ ${DOTS_PKG_COUNT_MISSING:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_MISSING} missing")
				echo "  managed: ${DOTS_PKG_COUNT_MANAGED:-0}"
				if [[ ${#drift_bits[@]} -gt 0 ]]; then
					local IFS=', '
					echo "  drift: ${drift_bits[*]}"
				else
					echo "  drift: none"
				fi
			fi
			echo "  detail: ./dots packages status"
		fi
		echo ""
		echo "Runtime:"
		echo "  multiplexer: ${mux}"
	else
		echo ""
		echo "Packages:"
		if ! command -v "${DOTS_BREW_BIN:-brew}" >/dev/null 2>&1; then
			echo "  Homebrew unavailable"
		else
			echo "  detail: ./dots packages status"
		fi
	fi

	echo ""
	echo "Models:"
	if [[ -f "$(dots_user_models_file)" ]]; then
		echo "  override: $(dots_user_models_file)"
	else
		echo "  override: (none — registry defaults)"
	fi
	# Best-effort inventory without requiring Stage 0
	if command -v ollama >/dev/null 2>&1; then
		local n
		n="$(ollama ls 2>/dev/null | awk 'NR>1 && NF{c++} END{print c+0}')"
		echo "  Ollama: ${n} model(s)"
	else
		echo "  Ollama: not installed"
	fi
	if command -v llama-cli >/dev/null 2>&1 || command -v llama >/dev/null 2>&1; then
		echo "  llama.cpp: installed (see llama-cli --cache-list)"
	else
		echo "  llama.cpp: not installed"
	fi
	if command -v draw-things-cli >/dev/null 2>&1; then
		echo "  Draw Things: CLI present"
	else
		echo "  Draw Things: not installed"
	fi
	if [[ -d /Applications/FluidVoice.app ]]; then
		echo "  FluidVoice: app present (models app-managed)"
	else
		echo "  FluidVoice: not installed"
	fi

	echo ""
	if declare -F dots_backup_status_lines >/dev/null 2>&1; then
		dots_backup_status_lines
	fi

	echo ""
	echo "Health:"
	local p="${profile_file:-${profile}}"
	if [[ ${p} == "(none)" || -z ${p} ]]; then
		p="base"
	fi
	if [[ -x ${DIR}/scripts/check.sh ]]; then
		local tmpc
		tmpc="$(mktemp "${TMPDIR:-/tmp}/dots-status.XXXXXX")"
		if "${DIR}/scripts/check.sh" --profile "${p}" >"${tmpc}" 2>&1; then
			echo "  check: OK (details via ./dots check)"
		else
			echo "  check: issues reported (run ./dots check)"
		fi
		rm -f "${tmpc}"
	else
		echo "  check: unavailable"
	fi
}

dots_cmd_backup() {
	local name=""
	if [[ ${1:-} == "import-legacy" ]]; then
		# shellcheck source=helpers/links.sh
		source "${DIR}/helpers/links.sh" 2>/dev/null || true
		# shellcheck source=helpers/toml.sh
		source "${DIR}/helpers/toml.sh" 2>/dev/null || true
		dots_backup_legacy_import
		return $?
	fi
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--name)
			name="${2:-}"
			shift 2
			continue
			;;
		--name=*)
			name="${1#*=}"
			shift
			continue
			;;
		-h | --help)
			echo "Usage: ./dots backup [--name NAME] | ./dots backup import-legacy"
			return 0
			;;
		*)
			echo "Unknown: $1" >&2
			return 1
			;;
		esac
	done
	# shellcheck source=helpers/links.sh
	source "${DIR}/helpers/links.sh" 2>/dev/null || true
	# shellcheck source=helpers/toml.sh
	source "${DIR}/helpers/toml.sh" 2>/dev/null || true
	if [[ -z ${name} ]]; then
		local def
		def="manual-$(date +%Y%m%d 2>/dev/null || echo now)"
		if [[ -t 0 ]] && declare -F dots_prompt_text >/dev/null 2>&1; then
			name="$(dots_prompt_text "Backup name" "${def}")"
		else
			name="${def}"
		fi
	fi
	local -a paths=()
	local p
	while IFS= read -r p; do
		[[ -n ${p} && (-e ${p} || -L ${p}) ]] && paths+=("${p}")
	done < <(dots_backup_inventory_unique)
	if [[ ${#paths[@]} -eq 0 ]]; then
		echo "Nothing to back up (no managed targets present)."
		return 0
	fi
	dots_backup_create --name "${name}" --reason "manual" "${paths[@]}"
}

dots_cmd_backups() {
	dots_ui_header "DOTS Snapshots"
	dots_backup_list
}

dots_cmd_restore() {
	local id="" dry=0 yes=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--dry-run) dry=1 ;;
		--yes | -y) yes=1 ;;
		-h | --help)
			echo "Usage: ./dots restore [snapshot-id] [--dry-run] [--yes]"
			return 0
			;;
		-*)
			echo "Unknown: $1" >&2
			return 1
			;;
		*) id="$1" ;;
		esac
		shift
	done
	if [[ -z ${id} ]]; then
		dots_backup_list
		if [[ -t 0 ]]; then
			id="$(dots_prompt_text "Snapshot id to restore" "")"
		else
			echo "Error: snapshot id required in noninteractive mode" >&2
			return 1
		fi
	fi
	local args=("${id}")
	[[ ${dry} -eq 1 ]] && args+=(--dry-run)
	[[ ${yes} -eq 1 ]] && args+=(--yes)
	dots_backup_restore "${args[@]}"
}

dots_cmd_profile() {
	dots_ui_load_answers
	dots_ui_header "Profiles"
	DOTS_UI_CHOICE_DEFAULT=1
	local c
	c="$(dots_prompt_choice "Profiles:" \
		"Show active" \
		"Create (configure.sh)" \
		"Preview resolved (--show)" \
		"Switch / reapply (bootstrap)" \
		"Back")"
	case "${c}" in
	1)
		dots_cmd_status
		;;
	2)
		exec "${DIR}/configure.sh"
		;;
	3)
		local p
		p="$(dots_prompt_text "Profile name or path" "home")"
		exec "${DIR}/bootstrap.sh" --profile "${p}" --show
		;;
	4)
		local p
		p="$(dots_prompt_text "Profile name or path" "home")"
		exec "${DIR}/bootstrap.sh" --profile "${p}"
		;;
	5) return 0 ;;
	esac
}

dots_cmd_models() {
	dots_ui_load_answers
	# Prefer loading hardware helpers when available
	# shellcheck source=hardware.sh
	source "${DIR}/helpers/hardware.sh" 2>/dev/null || true
	dots_ui_header "Models"
	if declare -F dots_hw_summary >/dev/null 2>&1; then
		dots_hw_summary
	fi
	DOTS_UI_CHOICE_DEFAULT=1
	local c
	c="$(dots_prompt_choice "Models:" \
		"Show model plan (--list)" \
		"Pull recommended missing models" \
		"Choose provider" \
		"Choose tier + pull" \
		"Update to registry targets (--update)" \
		"Edit model policy file" \
		"Back")"
	case "${c}" in
	1) exec "${DIR}/scripts/pull_models.sh" --list ;;
	2) exec "${DIR}/scripts/pull_models.sh" ;;
	3)
		local p
		DOTS_UI_CHOICE_DEFAULT=1
		p="$(dots_prompt_choice "Provider:" "ollama" "llamacpp" "drawthings" "fluidvoice" "all")"
		case "${p}" in
		1) exec "${DIR}/scripts/pull_models.sh" --provider ollama ;;
		2) exec "${DIR}/scripts/pull_models.sh" --provider llamacpp ;;
		3) exec "${DIR}/scripts/pull_models.sh" --provider drawthings ;;
		4) exec "${DIR}/scripts/pull_models.sh" --provider fluidvoice ;;
		5) exec "${DIR}/scripts/pull_models.sh" --provider all ;;
		esac
		;;
	4)
		local t
		DOTS_UI_CHOICE_DEFAULT=1
		t="$(dots_prompt_choice "Tier:" "auto" "minimal" "balanced" "large" "max")"
		case "${t}" in
		1) exec "${DIR}/scripts/pull_models.sh" --tier auto ;;
		2) exec "${DIR}/scripts/pull_models.sh" --tier minimal ;;
		3) exec "${DIR}/scripts/pull_models.sh" --tier balanced ;;
		4) exec "${DIR}/scripts/pull_models.sh" --tier large ;;
		5) exec "${DIR}/scripts/pull_models.sh" --tier max ;;
		esac
		;;
	5) exec "${DIR}/scripts/pull_models.sh" --update --yes ;;
	6)
		mkdir -p "$(dots_config_dir)"
		local mf
		mf="$(dots_user_models_file)"
		if [[ ! -f ${mf} ]]; then
			dots_write_models_override_bash "${mf}" "auto" "false" "" 0
			echo "Created ${mf}"
		fi
		echo "Edit: ${mf}"
		echo "Then: ./dots models → pull"
		;;
	7) return 0 ;;
	esac
}

dots_cmd_check() {
	local profile=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile)
			profile="${2:-}"
			shift
			;;
		--profile=*) profile="${1#*=}" ;;
		-h | --help)
			echo "Usage: ./dots check [--profile NAME|path]"
			return 0
			;;
		*)
			echo "Unknown: $1" >&2
			return 1
			;;
		esac
		shift
	done
	if [[ -z ${profile} ]]; then
		if dots_state_load_active 2>/dev/null; then
			profile="${DOTS_ACTIVE_PROFILE_FILE:-${DOTS_ACTIVE_PROFILE}}"
		else
			profile="base"
		fi
	fi
	exec "${DIR}/scripts/check.sh" --profile "${profile}"
}

dots_cmd_update() {
	dots_ui_load_answers
	dots_ui_header "Update DOTS"
	echo "  Current: v$(dots_version)"
	echo "  Repo: ${DIR}"
	local ans
	ans="$(dots_prompt_yesno "Fetch latest from git" y)"
	if [[ ${ans} != y ]]; then
		echo "Aborted."
		return 0
	fi
	# Delegate to scripts/update.sh when present (does not pull multi-GB models)
	if [[ -x ${DIR}/scripts/update.sh ]]; then
		ans="$(dots_prompt_yesno "Also reapply setup.sh after pull" y)"
		(
			cd "${DIR}"
			if [[ ${ans} == y ]]; then
				DOTS_DIR="${DIR}" bash "${DIR}/scripts/update.sh"
			else
				git pull --ff-only || git pull
			fi
		)
	else
		(
			cd "${DIR}"
			git pull --ff-only || git pull
		)
	fi
	echo ""
	echo "Note: model downloads and AI provider reconfiguration were NOT run."
	ans="$(dots_prompt_yesno "Show model plan (--list only)" n)"
	[[ ${ans} == y ]] && "${DIR}/scripts/pull_models.sh" --list || true
	ans="$(dots_prompt_yesno "Run health check" y)"
	if [[ ${ans} == y ]]; then
		local p="base"
		dots_state_load_active 2>/dev/null && p="${DOTS_ACTIVE_PROFILE_FILE:-${DOTS_ACTIVE_PROFILE:-base}}"
		"${DIR}/scripts/check.sh" --profile "${p}" || true
	fi
	echo "Update flow complete."
}

dots_cmd_packages() {
	local sub="${1:-}"
	shift || true

	# Resolve groups from active runtime when available
	DOTS_WITH_COMPONENTS=()
	if dots_state_load_active 2>/dev/null; then
		if [[ -f "$(dots_runtime_env_file)" ]]; then
			# shellcheck disable=SC1090
			source "$(dots_runtime_env_file)" 2>/dev/null || true
		fi
		if [[ -n ${DOTS_ACTIVE_COMPONENTS:-} ]]; then
			# shellcheck disable=SC2206
			DOTS_WITH_COMPONENTS=(${DOTS_ACTIVE_COMPONENTS})
		fi
	fi
	if declare -F dots_resolve_package_groups >/dev/null 2>&1; then
		dots_resolve_package_groups 2>/dev/null || true
	fi

	# Interactive menu when bare `packages` on a TTY
	if [[ -z ${sub} ]] && [[ -t 0 ]] && [[ -t 1 ]]; then
		dots_ui_header "DOTS Packages"
		echo ""
		echo "  1) status     ownership / drift (read-only)"
		echo "  2) outdated   managed packages with updates"
		echo "  3) upgrade    upgrade DOTS-managed packages"
		echo "  4) adopt      suggest Brewfile declaration"
		echo "  q) quit"
		echo ""
		local choice
		choice="$(dots_prompt_text "Choice" "1")"
		case "${choice}" in
		1 | status | s) sub=status ;;
		2 | outdated | o) sub=outdated ;;
		3 | upgrade | u) sub=upgrade ;;
		4 | adopt | a) sub=adopt ;;
		q | quit | Q) return 0 ;;
		*) sub=status ;;
		esac
	elif [[ -z ${sub} ]]; then
		sub=status
	fi

	case "${sub}" in
	status | st)
		dots_pkg_status_report
		;;
	outdated)
		dots_pkg_status_report 1
		echo "Outdated (managed):"
		if [[ ${#DOTS_PKG_OUTDATED_LINES[@]} -eq 0 ]]; then
			echo "  (none)"
		else
			local e
			for e in "${DOTS_PKG_OUTDATED_LINES[@]}"; do
				printf '  %s\n' "${e}"
			done
		fi
		echo ""
		echo "Note: unmanaged/outdated packages outside the desired set are ignored"
		echo "      unless you run: ./dots packages upgrade --all"
		;;
	upgrade)
		local warn_all=0 a
		for a in "$@"; do
			[[ ${a} == --all ]] && warn_all=1
		done
		if [[ ${warn_all} -eq 1 ]]; then
			echo "These packages are not DOTS-managed and will be updated by Homebrew anyway."
			echo "(--all includes undeclared Homebrew packages)"
			echo ""
		fi
		dots_pkg_upgrade "$@"
		;;
	adopt)
		# Recommendation only — never edits Brewfiles during normal setup.
		local kind="brew" name="" dest=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--cask)
				kind=cask
				shift
				name="${1:-}"
				shift || true
				;;
			--formula | --brew)
				kind=brew
				shift
				name="${1:-}"
				shift || true
				;;
			--group)
				shift
				dest="brew/groups/${1:-modern}.Brewfile"
				shift || true
				;;
			--component)
				shift
				dest="brew/Brewfile.${1:-}"
				shift || true
				;;
			-h | --help)
				echo "Usage: ./dots packages adopt <name> [--group modern|--component mactools] [--cask]"
				return 0
				;;
			-*)
				echo "Unknown adopt option: $1" >&2
				return 1
				;;
			*)
				[[ -z ${name} ]] && name="$1"
				shift || true
				;;
			esac
		done
		if [[ -z ${name} ]]; then
			echo "Usage: ./dots packages adopt <name> [--group modern|--component mactools] [--cask]" >&2
			echo "Suggests a Brewfile declaration; does not edit repository files." >&2
			return 1
		fi
		if [[ -z ${dest} ]]; then
			if [[ ${kind} == cask ]]; then
				dest="brew/Brewfile.<component>   # or brew/groups/gui.Brewfile"
			else
				dest="brew/groups/modern.Brewfile"
			fi
		fi
		dots_pkg_suggest_declare "${kind}" "${name}" "${dest}"
		;;
	-h | --help | help)
		cat <<EOF
Usage:
  ./dots packages              interactive menu (TTY) or status
  ./dots packages status       full ownership report (read-only)
  ./dots packages outdated     outdated managed packages
  ./dots packages upgrade      upgrade packages in the resolved desired set
  ./dots packages upgrade --all
                               also upgrade undeclared Homebrew packages (opt-in)
  ./dots packages adopt NAME [--group G|--component C] [--cask]
                               print suggested Brewfile declaration (no auto-edit)

Ownership vocabulary:
  managed     declared by resolved DOTS config + package-manager owned
  missing     declared but absent
  outdated    declared, managed, update available
  external    declared; app exists outside Homebrew ownership
  undeclared  installed (leaves/casks) but not in resolved desired set

DOTS never runs brew bundle cleanup or uninstalls undeclared software.
EOF
		;;
	*)
		echo "Unknown packages subcommand: ${sub}" >&2
		echo "Try: ./dots packages help" >&2
		return 1
		;;
	esac
}

# --- dispatch ---
cmd="${1:-setup}"
case "${cmd}" in
-h | --help | help)
	dots_usage
	exit 0
	;;
--version | -V | version)
	echo "dots $(dots_version)"
	exit 0
	;;
setup)
	shift || true
	dots_cmd_setup "$@"
	;;
status)
	shift || true
	dots_cmd_status "$@"
	;;
packages | package)
	shift || true
	dots_cmd_packages "$@"
	;;
backup)
	shift || true
	dots_cmd_backup "$@"
	;;
backups)
	shift || true
	dots_cmd_backups "$@"
	;;
restore)
	shift || true
	dots_cmd_restore "$@"
	;;
profile)
	shift || true
	dots_cmd_profile "$@"
	;;
models)
	shift || true
	dots_cmd_models "$@"
	;;
check)
	shift || true
	dots_cmd_check "$@"
	;;
update)
	shift || true
	dots_cmd_update "$@"
	;;
"")
	dots_cmd_setup
	;;
*)
	# Bare ./dots with no known subcommand: if first arg looks like a flag for setup
	if [[ ${cmd} == --* ]]; then
		dots_cmd_setup "$@"
	else
		echo "Unknown command: ${cmd}" >&2
		dots_usage >&2
		exit 1
	fi
	;;
esac
