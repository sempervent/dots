#!/usr/bin/env bash
# dots — unified human-facing entrypoint for sempervent/dots
#
# Orchestrates existing subsystems; does not duplicate install/model logic.
# Pure-Bash UI (no gum/dialog/fzf required).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

DOTS_APPLY_STARTED=0
dots_on_interrupt() {
	if [[ ${DOTS_APPLY_STARTED} -eq 1 ]]; then
		echo "" >&2
		echo "Setup interrupted." >&2
		echo "Re-run ./dots; operations are idempotent." >&2
	else
		echo "" >&2
		echo "No changes made." >&2
	fi
	exit 130
}
trap dots_on_interrupt INT

# shellcheck source=helpers/ui.sh
source "${DIR}/helpers/ui.sh"
# shellcheck source=helpers/state.sh
source "${DIR}/helpers/state.sh"
# shellcheck source=helpers/backup.sh
source "${DIR}/helpers/backup.sh"
# shellcheck source=helpers/wizard.sh
source "${DIR}/helpers/wizard.sh"
# shellcheck source=helpers/packages.sh
source "${DIR}/helpers/packages.sh"
# shellcheck source=helpers/components.sh
source "${DIR}/helpers/components.sh"
# shellcheck source=helpers/lsp.sh
source "${DIR}/helpers/lsp.sh"
# shellcheck source=helpers/ai_server.sh
source "${DIR}/helpers/ai_server.sh"
# shellcheck source=helpers/package_state.sh
source "${DIR}/helpers/package_state.sh"
# shellcheck source=helpers/cask_apps.sh
source "${DIR}/helpers/cask_apps.sh"
# shellcheck source=helpers/hardware.sh
source "${DIR}/helpers/hardware.sh"
# shellcheck source=helpers/linux_distro.sh
source "${DIR}/helpers/linux_distro.sh"
# shellcheck source=helpers/suggest.sh
source "${DIR}/helpers/suggest.sh"
# shellcheck source=helpers/shell_diag.sh
source "${DIR}/helpers/shell_diag.sh"
# shellcheck source=helpers/profiles.sh
source "${DIR}/helpers/profiles.sh"
# shellcheck source=helpers/profile_edit.sh
source "${DIR}/helpers/profile_edit.sh"

dots_usage() {
	# Prefer generated synopsis (configs/help/commands.toml → scripts/docs/generate_usage.py)
	# Strip generator comment headers so --help stays clean for humans/CI.
	local gen="${DIR}/scripts/generated/dots_usage.inc"
	if [[ -f ${gen} ]]; then
		grep -v '^#' "${gen}" || true
		return 0
	fi
	cat <<EOF
DOTS — machine environment manager  (v$(dots_version))

Usage:
  ./dots setup               setup / reconfigure
  ./dots status              current state (read-only)
  ./dots help                interactive help (dots-help)
  ./dots --help              this synopsis
  ./dots --version

Regenerate synopsis: python3 scripts/docs/generate_usage.py
EOF
}

dots_cmd_tui() {
	local arg
	for arg in "$@"; do
		case "${arg}" in
		-h | --help | help)
			cat <<'EOF'
Usage: ./dots tui

Launch the dynamic Textual desired-state TUI (front-end over DOTS registries,
structured state APIs, and helpers/profile_edit.sh).

Noninteractive fallback commands remain available without Textual:
  ./dots install   ./dots upgrade   ./dots profile   ./dots setup   ./dots status
EOF
			return 0
			;;
		esac
	done

	if [[ ! -t 0 || ! -t 1 || ${TERM:-} == dumb ]]; then
		echo "Error: ./dots tui requires an interactive TTY." >&2
		echo "Use noninteractive commands instead:" >&2
		echo "  ./dots profile show --json" >&2
		echo "  ./dots install <selector> --yes" >&2
		echo "  ./dots upgrade --dry-run" >&2
		return 1
	fi

	local helper="${DIR}/scripts/dots-help"
	if [[ -x ${helper} ]]; then
		"${helper}" --mode tui "$@"
		return $?
	fi
	if command -v dots-help >/dev/null 2>&1; then
		dots-help --mode tui "$@"
		return $?
	fi
	echo "Error: dots-help Textual runtime not installed yet; run ./setup.sh or use ./dots setup." >&2
	return 1
}

dots_cmd_help() {
	local helper="${DIR}/scripts/dots-help"
	if [[ -x ${helper} ]]; then
		exec "${helper}" "$@"
	fi
	if command -v dots-help >/dev/null 2>&1; then
		exec dots-help "$@"
	fi
	echo "dots-help not installed yet; showing CLI synopsis." >&2
	echo "Run ./setup.sh to install the Textual help TUI." >&2
	echo "" >&2
	dots_usage
	return 0
}

dots_cmd_status() {
	dots_ui_header "DOTS Status"
	echo ""
	echo "Version:"
	echo "  $(dots_version)"
	echo ""

	local profile="(none)" profile_file="" mux="(unknown)"
	if dots_state_load_active 2>/dev/null; then
		profile="${DOTS_ACTIVE_PROFILE:-unknown}"
		profile_file="${DOTS_ACTIVE_PROFILE_FILE:-}"
	fi
	echo "Profile:"
	echo "  ${profile}"
	[[ -n ${profile_file} ]] && echo "  file: ${profile_file}"

	echo ""
	if declare -F dots_linux_platform_report >/dev/null 2>&1; then
		dots_linux_platform_report
	else
		echo "Platform:"
		echo "  OS: $(uname -s)"
		echo "  architecture: $(uname -m)"
	fi

	if [[ -f "$(dots_runtime_env_file)" ]]; then
		# shellcheck disable=SC1090
		source "$(dots_runtime_env_file)" 2>/dev/null || true
		mux="${DOTS_MULTIPLEXER:-tmux}"
		echo ""
		echo "Packages:"
		echo "  groups: ${DOTS_PACKAGE_GROUPS:-(see profile)}"
		# Concise drift (fast mode skips brew outdated). Never abort status.
		if ! command -v "${DOTS_BREW_BIN:-brew}" >/dev/null 2>&1; then
			echo "  Homebrew unavailable"
		elif declare -F dots_pkg_status_report >/dev/null 2>&1; then
			DOTS_WITH_COMPONENTS=()
			if [[ -n ${DOTS_ACTIVE_COMPONENTS:-} ]]; then
				# shellcheck disable=SC2206
				DOTS_WITH_COMPONENTS=(${DOTS_ACTIVE_COMPONENTS})
			fi
			declare -F dots_resolve_package_groups >/dev/null 2>&1 &&
				dots_resolve_package_groups 2>/dev/null || true
			# quiet=1 fast=1 — skip outdated queries to keep status snappy
			if dots_pkg_status_report 1 1 2>/dev/null; then
				local drift_bits=()
				[[ ${DOTS_PKG_COUNT_EXTERNAL:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_EXTERNAL} external")
				[[ ${DOTS_PKG_COUNT_INACTIVE:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_INACTIVE} inactive")
				[[ ${DOTS_PKG_COUNT_UNDECLARED:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_UNDECLARED} undeclared")
				[[ ${DOTS_PKG_COUNT_MISSING:-0} -gt 0 ]] && drift_bits+=("${DOTS_PKG_COUNT_MISSING} missing")
				echo "  managed: ${DOTS_PKG_COUNT_MANAGED:-0}"
				if [[ ${#drift_bits[@]} -gt 0 ]]; then
					local IFS=', '
					echo "  drift: ${drift_bits[*]}"
				else
					echo "  drift: none"
				fi
			fi
		fi
		echo "  status:  ./dots packages status"
		echo "  upgrade: ./dots upgrade"
		echo "  install: ./dots install <name>"
		echo "  plan:    ./dots packages plan"
		echo "  groups:  ./dots packages groups"
		echo ""
		echo "Components:"
		if [[ -n ${DOTS_ACTIVE_COMPONENTS:-} ]]; then
			echo "  active: ${DOTS_ACTIVE_COMPONENTS}"
		else
			echo "  active: (none recorded)"
		fi
		echo "  detail: ./dots components active"
		echo "  (informational — mutating setup needs profile/--with)"
		case " ${DOTS_ACTIVE_COMPONENTS:-} " in
		*" lsp "*)
			echo ""
			dots_lsp_summary
			;;
		esac
		echo ""
		echo "Runtime:"
		echo "  multiplexer: ${mux}"
	else
		echo ""
		echo "Packages:"
		if ! command -v "${DOTS_BREW_BIN:-brew}" >/dev/null 2>&1; then
			echo "  Homebrew unavailable"
		else
			echo "  status:  ./dots packages status"
			echo "  upgrade: ./dots upgrade"
			echo "  install: ./dots install <name>"
		fi
	fi

	echo ""
	echo "Models:"
	if [[ -f "$(dots_user_models_file)" ]]; then
		echo "  override: $(dots_user_models_file)"
	else
		echo "  override: (none — registry defaults)"
	fi
	# Best-effort inventory without requiring Stage 0
	if command -v ollama >/dev/null 2>&1; then
		local n
		n="$(ollama ls 2>/dev/null | awk 'NR>1 && NF{c++} END{print c+0}' || true)"
		n="${n:-0}"
		echo "  Ollama: ${n} model(s)"
	else
		echo "  Ollama: not installed"
	fi
	if command -v llama-cli >/dev/null 2>&1 || command -v llama >/dev/null 2>&1; then
		echo "  llama.cpp: installed (see llama-cli --cache-list)"
	else
		echo "  llama.cpp: not installed"
	fi
	if command -v draw-things-cli >/dev/null 2>&1; then
		echo "  Draw Things: CLI present"
	else
		echo "  Draw Things: not installed"
	fi
	if [[ -d /Applications/FluidVoice.app ]]; then
		echo "  FluidVoice: app present (models app-managed)"
	else
		echo "  FluidVoice: not installed"
	fi

	echo ""
	if declare -F dots_backup_status_lines >/dev/null 2>&1; then
		dots_backup_status_lines
	fi

	echo ""
	echo "Health:"
	local p="${profile_file:-${profile}}"
	if [[ ${p} == "(none)" || -z ${p} ]]; then
		p="base"
	fi
	if [[ -x ${DIR}/scripts/check.sh ]]; then
		local tmpc
		tmpc="$(mktemp "${TMPDIR:-/tmp}/dots-status.XXXXXX")"
		if "${DIR}/scripts/check.sh" --profile "${p}" >"${tmpc}" 2>&1; then
			echo "  check: OK (details via ./dots check)"
		else
			echo "  check: issues reported (run ./dots check)"
		fi
		rm -f "${tmpc}"
	else
		echo "  check: unavailable"
	fi

	echo ""
	echo "Shell:"
	local shn prompt_bits=()
	shn="$(basename "${SHELL:-unknown}")"
	command -v starship >/dev/null 2>&1 && prompt_bits+=("Starship")
	if [[ -f ${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}/plugins/fzf-tab/fzf-tab.plugin.zsh ]] ||
		[[ -f ${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}/plugins/fzf-tab/fzf-tab.zsh ]]; then
		prompt_bits+=("fzf-tab")
	fi
	if [[ ${#prompt_bits[@]} -gt 0 ]]; then
		local IFS=' · '
		echo "  ${shn} · ${prompt_bits[*]}"
	else
		echo "  ${shn}"
	fi
	echo "  detail: ./dots shell status"

	echo ""
	echo "Help:"
	echo "  dots-help"
	echo "  man dots"
}

dots_cmd_backup() {
	local name=""
	if [[ ${1:-} == "import-legacy" ]]; then
		# shellcheck source=helpers/links.sh
		source "${DIR}/helpers/links.sh" 2>/dev/null || true
		# shellcheck source=helpers/toml.sh
		source "${DIR}/helpers/toml.sh" 2>/dev/null || true
		dots_backup_legacy_import
		return $?
	fi
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--name)
			name="${2:-}"
			shift 2
			continue
			;;
		--name=*)
			name="${1#*=}"
			shift
			continue
			;;
		-h | --help)
			echo "Usage: ./dots backup [--name NAME] | ./dots backup import-legacy"
			return 0
			;;
		*)
			echo "Unknown: $1" >&2
			return 1
			;;
		esac
	done
	# shellcheck source=helpers/links.sh
	source "${DIR}/helpers/links.sh" 2>/dev/null || true
	# shellcheck source=helpers/toml.sh
	source "${DIR}/helpers/toml.sh" 2>/dev/null || true
	if [[ -z ${name} ]]; then
		local def
		def="manual-$(date +%Y%m%d 2>/dev/null || echo now)"
		if [[ -t 0 ]] && declare -F dots_prompt_text >/dev/null 2>&1; then
			name="$(dots_prompt_text "Backup name" "${def}")"
		else
			name="${def}"
		fi
	fi
	local -a paths=()
	local p
	while IFS= read -r p; do
		[[ -n ${p} && (-e ${p} || -L ${p}) ]] && paths+=("${p}")
	done < <(dots_backup_inventory_unique)
	if [[ ${#paths[@]} -eq 0 ]]; then
		echo "Nothing to back up (no managed targets present)."
		return 0
	fi
	dots_backup_create --name "${name}" --reason "manual" "${paths[@]}"
}

dots_cmd_backups() {
	dots_ui_header "DOTS Snapshots"
	dots_backup_list
}

dots_cmd_restore() {
	local id="" dry=0 yes=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--dry-run) dry=1 ;;
		--yes | -y) yes=1 ;;
		-h | --help)
			echo "Usage: ./dots restore [snapshot-id] [--dry-run] [--yes]"
			return 0
			;;
		-*)
			echo "Unknown: $1" >&2
			return 1
			;;
		*) id="$1" ;;
		esac
		shift
	done
	if [[ -z ${id} ]]; then
		dots_backup_list
		if [[ -t 0 ]]; then
			id="$(dots_prompt_text "Snapshot id to restore" "")"
		else
			echo "Error: snapshot id required in noninteractive mode" >&2
			return 1
		fi
	fi
	local args=("${id}")
	[[ ${dry} -eq 1 ]] && args+=(--dry-run)
	[[ ${yes} -eq 1 ]] && args+=(--yes)
	dots_backup_restore "${args[@]}"
}

dots_cmd_install() {
	local selector="" dry=0 yes=0 no_apply=0 profile_arg="" only=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--dry-run) dry=1 ;;
		--only) only=1 ;;
		--yes | -y) yes=1 ;;
		--no-apply) no_apply=1 ;;
		--profile)
			profile_arg="${2:-}"
			[[ -n ${profile_arg} ]] || {
				echo "Error: --profile requires a value" >&2
				return 1
			}
			shift
			;;
		--profile=*) profile_arg="${1#*=}" ;;
		-h | --help | help)
			cat <<'EOF'
Usage: ./dots install SELECTOR [options]

Add a known DOTS capability (package group, component, supergroup, or package)
to this machine's persistent desired profile and converge toward it.

Does NOT install arbitrary undeclared packages (use ./dots packages adopt
for maintainer Brewfile declarations).

Options:
  --dry-run         Preview owner resolution, profile diff, and package plan
  --only            Persist explicit package only (leaf-selectable packages)
  --yes, -y         Skip confirmation prompt
  --no-apply        Persist desired profile update without running bootstrap
  --profile NAME    Target profile (default: active profile)

Examples:
  ./dots install dev
  ./dots install hyperfine
  ./dots install raycast --only --dry-run
  ./dots install karabiner-elements
  ./dots install ai
  ./dots install sshuttle --dry-run
EOF
			return 0
			;;
		-*)
			echo "Error: unknown install option: $1" >&2
			return 1
			;;
		*)
			if [[ -z ${selector} ]]; then
				selector="$1"
			else
				echo "Error: unexpected argument: $1 (pass one selector per invocation)" >&2
				return 1
			fi
			;;
		esac
		shift
	done

	local allow_prompt=1
	if [[ ${DOTS_UI_NONINTERACTIVE:-0} -eq 1 ]] || { [[ ! -t 0 ]] && [[ -z ${DOTS_UI_ANSWERS:-} ]]; }; then
		allow_prompt=0
	fi

	if [[ -z ${selector} ]]; then
		if [[ ${allow_prompt} -eq 1 ]]; then
			[[ -z ${DOTS_UI_ANSWER_FD:-} ]] && dots_ui_load_answers
			echo "DOTS Install"
			echo ""
			echo "  1) Search all software"
			echo "  2) Browse individual packages/apps"
			echo "  3) Browse package groups"
			echo "  4) Browse optional components"
			echo "  5) Browse bundles"
			echo "  q) Quit"
			local menu_choice
			menu_choice="$(dots_ui_read_line "Choose" "1")" || return 1
			case "${menu_choice}" in
			q | Q)
				echo "Aborted."
				return 0
				;;
			2)
				./dots packages leaves || true
				selector="$(dots_ui_read_line "Package id" "")" || return 1
				;;
			3)
				./dots packages groups || true
				selector="$(dots_ui_read_line "Package group" "")" || return 1
				;;
			4)
				./dots components list || true
				selector="$(dots_ui_read_line "Component id" "")" || return 1
				;;
			5)
				selector="$(dots_ui_read_line "Bundle id" "")" || return 1
				;;
			1 | *)
				selector="$(dots_ui_read_line "Search software" "")" || return 1
				;;
			esac
		fi
	fi
	[[ -n ${selector} ]] || {
		echo "Error: selector required (e.g. ./dots install hyperfine)" >&2
		return 1
	}

	# 1. Resolve selector -> DOTS_SEL_OWNER
	dots_resolve_capability_selector "${selector}" "${allow_prompt}" || return 1

	# Platform check for explicit leaf component
	if [[ ${DOTS_SEL_KIND} == "component" ]]; then
		dots_require_explicit_component_supported "${DOTS_SEL_ID}" || return 1
	fi
	# Package/group installability check (never persist unsatisfiable direct package requests)
	dots_install_pick_owner_mode "${only}" "${allow_prompt}" "${yes}" || return 1
	dots_require_selector_installable || return 1

	# 2. Explain resolution & scope
	echo "DOTS Install"
	echo ""
	echo "Requested:"
	echo "  ${selector}"
	echo "Owner:"
	echo "  ${DOTS_SEL_OWNER}"
	if [[ -n ${DOTS_SEL_VIA_PKG} ]]; then
		echo ""
		if [[ ${DOTS_SEL_KIND} == "group" ]]; then
			echo "${DOTS_SEL_VIA_PKG} is provided by package group '${DOTS_SEL_ID}'."
		else
			echo "${DOTS_SEL_VIA_PKG} is provided by ${DOTS_SEL_KIND} '${DOTS_SEL_ID}'."
		fi
	fi
	case "${DOTS_SEL_KIND}" in
	group)
		local desc p line=""
		desc="$(dots_group_description "${DOTS_SEL_ID}" 2>/dev/null || true)"
		[[ -n ${desc} ]] && echo "Role: ${desc}"
		if [[ -n ${DOTS_SEL_INSTALL_SUMMARY:-} ]]; then
			local _counts _unsup
			_counts="${DOTS_SEL_INSTALL_SUMMARY%%$'\t'*}"
			_unsup="${DOTS_SEL_INSTALL_SUMMARY#*$'\t'}"
			echo "Packages: ${_counts} supported on this platform"
			if [[ -n ${_unsup} ]]; then
				echo "Unavailable (optional; skipped):"
				echo "  ${_unsup//,/ }"
			fi
		fi
		echo ""
		echo "Adding ${DOTS_SEL_ID} also makes these packages desired:"
		while IFS= read -r p; do
			[[ -z ${p} ]] && continue
			line="${line}${line:+ }${p}"
		done < <(dots_pe_group_packages "${DOTS_SEL_ID}")
		echo "  ${line:-(none)}"
		;;
	component)
		local desc rel kind tok
		desc="$(dots_component_description "${DOTS_SEL_ID}" 2>/dev/null || true)"
		[[ -n ${desc} ]] && echo "Role: ${desc}"
		if rel="$(dots_component_brewfile "${DOTS_SEL_ID}" 2>/dev/null)" && [[ -f ${DIR}/${rel} ]]; then
			echo ""
			echo "Component packages (${rel}):"
			while IFS=$'\t' read -r kind tok; do
				[[ -z ${tok} ]] && continue
				echo "  ${kind}: ${tok}"
			done < <(dots_brewfile_tokens "${DIR}/${rel}" all)
		fi
		;;
	supergroup)
		echo ""
		echo "Expanding supergroup '${DOTS_SEL_ID}' (platform-filtered; explicit consent):"
		local m reason
		while IFS= read -r m; do
			[[ -z ${m} ]] && continue
			if dots_component_supported_here "${m}"; then
				echo "  + ${m}"
			else
				reason="$(dots_component_unsupported_reason "${m}" 2>/dev/null || echo unsupported)"
				echo "  - ${m} (skipped: ${reason})"
			fi
		done < <(dots_supergroup_members "${DOTS_SEL_ID}")
		;;
	esac

	# 3. Resolve target profile & overlay (never mutate builtins or user-authored custom files)
	dots_profile_edit_resolve_target "${profile_arg}" "${allow_prompt}" || return 1

	# 4. Compute sparse edit & diff
	local tmp_toml tmp_diff
	tmp_toml="$(mktemp "${TMPDIR:-/tmp}/dots-install-toml.XXXXXX")"
	tmp_diff="$(mktemp "${TMPDIR:-/tmp}/dots-install-diff.XXXXXX")"
	if ! dots_profile_edit_compute add "${DOTS_SEL_OWNER}" \
		"${DOTS_PE_SOURCE_FILE}" "${DOTS_PE_OVERLAY_FILE}" \
		"${DOTS_PE_OVERLAY_NAME}" "${DOTS_PE_EXTENDS_VAL}" \
		"${tmp_toml}" "${tmp_diff}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi

	echo ""
	if [[ ${DOTS_PE_CHANGED} -eq 0 ]]; then
		echo "${DOTS_PE_STATUS_MSG}"
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	echo "Profile delta:"
	sed 's/^/  /' "${tmp_diff}"
	echo ""
	if [[ ${no_apply} -eq 1 ]]; then
		echo "Mode: persist profile only (--no-apply)"
	else
		echo "Mode: persist profile + converge via bootstrap.sh"
	fi

	# 5. Dry-run stops here with zero mutation
	if [[ ${dry} -eq 1 ]]; then
		echo ""
		echo "[dry-run] Would write overlay: ${DOTS_PE_OVERLAY_FILE}"
		if [[ ${no_apply} -eq 0 ]]; then
			echo "[dry-run] Would run: ./bootstrap.sh --profile ${DOTS_PE_OVERLAY_FILE}"
		fi
		echo "[dry-run] No files modified and no packages installed."
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	# 6. Confirm unless --yes
	if [[ ${yes} -ne 1 ]]; then
		if [[ ${allow_prompt} -eq 1 ]]; then
			[[ -z ${DOTS_UI_ANSWER_FD:-} ]] && dots_ui_load_answers
			local ans
			ans="$(dots_prompt_yesno "Proceed" y)" || {
				rm -f "${tmp_toml}" "${tmp_diff}"
				echo "Aborted. No changes made."
				return 0
			}
			if [[ ${ans} != y ]]; then
				rm -f "${tmp_toml}" "${tmp_diff}"
				echo "Aborted. No changes made."
				return 0
			fi
		else
			rm -f "${tmp_toml}" "${tmp_diff}"
			echo "Error: confirmation required in noninteractive mode (pass --yes or --dry-run)" >&2
			return 1
		fi
	fi

	# 7. Atomic persist
	if ! dots_profile_edit_commit_atomic "${DOTS_PE_OVERLAY_FILE}" "${tmp_toml}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi
	rm -f "${tmp_toml}" "${tmp_diff}"

	if [[ ${no_apply} -eq 1 ]]; then
		echo ""
		echo "Profile updated."
		echo ""
		echo "Apply later:"
		echo "  dots profile apply"
		return 0
	fi

	# 8. Converge via bootstrap.sh — never revert desired profile on apply failure
	local boot_bin="${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}"
	echo ""
	if "${boot_bin}" --profile "${DOTS_PE_OVERLAY_FILE}"; then
		echo ""
		echo "OK: ${DOTS_SEL_OWNER} persisted in ${DOTS_PE_OVERLAY_NAME} and applied."
		return 0
	fi

	echo "" >&2
	echo "Desired state updated successfully." >&2
	echo "" >&2
	echo "Machine convergence failed." >&2
	echo "" >&2
	echo "Current desired profile:" >&2
	echo "  ${DOTS_PE_OVERLAY_NAME}" >&2
	echo "" >&2
	echo "Retry:" >&2
	echo "  dots profile apply" >&2
	echo "" >&2
	echo "Diagnostics:" >&2
	echo "  dots check --profile ${DOTS_PE_OVERLAY_NAME}" >&2
	return 1
}

dots_cmd_upgrade() {
	local has_profile=0 a
	for a in "$@"; do
		case "${a}" in
		--profile | --profile=*) has_profile=1 ;;
		-h | --help)
			dots_pkg_upgrade --help
			return 0
			;;
		esac
	done
	if [[ ${has_profile} -eq 0 ]] && declare -F dots_packages_plan_load_profile >/dev/null 2>&1; then
		dots_packages_plan_load_profile "" >/dev/null 2>&1 || true
	fi
	dots_pkg_upgrade "$@"
}

_dots_profile_edit_subcmd() {
	local action="$1"
	shift
	local selector="" profile_arg="" apply=0 dry=0 yes=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile)
			profile_arg="${2:-}"
			[[ -n ${profile_arg} ]] || {
				echo "Error: --profile requires a value" >&2
				return 1
			}
			shift
			;;
		--profile=*) profile_arg="${1#*=}" ;;
		--apply) apply=1 ;;
		--dry-run) dry=1 ;;
		--yes | -y) yes=1 ;;
		-h | --help)
			echo "Usage: ./dots profile ${action} SELECTOR [--profile NAME|PATH] [--apply] [--dry-run] [--yes]"
			return 0
			;;
		-*)
			echo "Error: unknown profile ${action} option: $1" >&2
			return 1
			;;
		*)
			if [[ -z ${selector} ]]; then
				selector="$1"
			else
				echo "Error: unexpected argument: $1" >&2
				return 1
			fi
			;;
		esac
		shift
	done

	local allow_prompt=1
	if [[ ${DOTS_UI_NONINTERACTIVE:-0} -eq 1 ]] || { [[ ! -t 0 ]] && [[ -z ${DOTS_UI_ANSWERS:-} ]]; }; then
		allow_prompt=0
	fi
	if [[ -z ${selector} ]] && [[ ${allow_prompt} -eq 1 ]]; then
		[[ -z ${DOTS_UI_ANSWER_FD:-} ]] && dots_ui_load_answers
		selector="$(dots_prompt_text "Selector (group, component, supergroup, or package)" "")" || return 1
	fi
	[[ -n ${selector} ]] || {
		echo "Error: selector required (e.g. ./dots profile ${action} dev)" >&2
		return 1
	}

	dots_resolve_capability_selector "${selector}" "${allow_prompt}" || return 1
	if [[ ${action} == "add" ]]; then
		if [[ ${DOTS_SEL_KIND} == "component" ]]; then
			dots_require_explicit_component_supported "${DOTS_SEL_ID}" || return 1
		fi
		dots_require_selector_installable || return 1
	fi
	dots_profile_edit_resolve_target "${profile_arg}" "${allow_prompt}" || return 1

	local tmp_toml tmp_diff
	tmp_toml="$(mktemp "${TMPDIR:-/tmp}/dots-prof-toml.XXXXXX")"
	tmp_diff="$(mktemp "${TMPDIR:-/tmp}/dots-prof-diff.XXXXXX")"
	if ! dots_profile_edit_compute "${action}" "${DOTS_SEL_OWNER}" \
		"${DOTS_PE_SOURCE_FILE}" "${DOTS_PE_OVERLAY_FILE}" \
		"${DOTS_PE_OVERLAY_NAME}" "${DOTS_PE_EXTENDS_VAL}" \
		"${tmp_toml}" "${tmp_diff}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi

	if [[ ${DOTS_PE_CHANGED} -eq 0 ]]; then
		echo "${DOTS_PE_STATUS_MSG}"
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	cat "${tmp_diff}"
	if [[ ${dry} -eq 1 ]]; then
		echo ""
		echo "[dry-run] Would write overlay: ${DOTS_PE_OVERLAY_FILE}"
		[[ ${apply} -eq 1 ]] && echo "[dry-run] Would apply: ./bootstrap.sh --profile ${DOTS_PE_OVERLAY_FILE}"
		echo "[dry-run] No files modified."
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	if [[ ${yes} -ne 1 && ${allow_prompt} -eq 1 ]]; then
		[[ -z ${DOTS_UI_ANSWER_FD:-} ]] && dots_ui_load_answers
		local ans
		ans="$(dots_prompt_yesno "Write profile change" y)" || {
			rm -f "${tmp_toml}" "${tmp_diff}"
			echo "Aborted. No changes made."
			return 0
		}
		if [[ ${ans} != y ]]; then
			rm -f "${tmp_toml}" "${tmp_diff}"
			echo "Aborted. No changes made."
			return 0
		fi
	fi

	if ! dots_profile_edit_commit_atomic "${DOTS_PE_OVERLAY_FILE}" "${tmp_toml}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi
	rm -f "${tmp_toml}" "${tmp_diff}"

	echo "OK: updated ${DOTS_PE_OVERLAY_FILE} (active: ${DOTS_PE_OVERLAY_NAME})"
	if [[ ${action} == "remove" ]]; then
		echo "Note: removing desired state does not uninstall already-installed packages."
	fi

	if [[ ${apply} -eq 1 ]]; then
		local boot_bin="${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}"
		if ! "${boot_bin}" --profile "${DOTS_PE_OVERLAY_FILE}"; then
			echo "Desired state updated successfully. Machine convergence failed." >&2
			echo "Retry: ./dots profile apply" >&2
			return 1
		fi
	else
		echo "Apply later: ./dots profile apply"
	fi
	return 0
}

