_dots_profile_mutate_subcmd() {
	local profile_arg="" expected_hash="" apply=0 dry=0 yes=0
	local -a add_raws=() rem_raws=() add_pkgs=() rem_pkgs=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile)
			profile_arg="${2:-}"
			[[ -n ${profile_arg} ]] || {
				echo "Error: --profile requires a value" >&2
				return 1
			}
			shift
			;;
		--profile=*) profile_arg="${1#*=}" ;;
		--add)
			[[ -n ${2:-} ]] || {
				echo "Error: --add requires a selector" >&2
				return 1
			}
			add_raws+=("${2}")
			shift
			;;
		--add=*) add_raws+=("${1#*=}") ;;
		--remove)
			[[ -n ${2:-} ]] || {
				echo "Error: --remove requires a selector" >&2
				return 1
			}
			rem_raws+=("${2}")
			shift
			;;
		--remove=*) rem_raws+=("${1#*=}") ;;
		--add-package)
			[[ -n ${2:-} ]] || {
				echo "Error: --add-package requires a package id" >&2
				return 1
			}
			add_pkgs+=("${2}")
			shift
			;;
		--add-package=*) add_pkgs+=("${1#*=}") ;;
		--remove-package)
			[[ -n ${2:-} ]] || {
				echo "Error: --remove-package requires a package id" >&2
				return 1
			}
			rem_pkgs+=("${2}")
			shift
			;;
		--remove-package=*) rem_pkgs+=("${1#*=}") ;;
		--expected-hash)
			expected_hash="${2:-}"
			shift
			;;
		--expected-hash=*) expected_hash="${1#*=}" ;;
		--apply) apply=1 ;;
		--dry-run) dry=1 ;;
		--yes | -y) yes=1 ;;
		-h | --help)
			echo "Usage: ./dots profile mutate [--profile NAME|PATH] [--add SEL]... [--remove SEL]... [--add-package PKG]... [--remove-package PKG]... [--expected-hash SHA] [--apply] [--dry-run] [--yes]"
			return 0
			;;
		*)
			echo "Error: unknown profile mutate option: $1" >&2
			return 1
			;;
		esac
		shift
	done

	if [[ ${#add_raws[@]} -eq 0 && ${#rem_raws[@]} -eq 0 && ${#add_pkgs[@]} -eq 0 && ${#rem_pkgs[@]} -eq 0 ]]; then
		echo "Error: profile mutate requires at least one --add, --remove, --add-package, or --remove-package" >&2
		return 1
	fi

	# Validate and resolve EVERY selector BEFORE computing/writing anything (atomic all-or-nothing)
	local -a resolved_adds=() resolved_rems=()
	local s
	for s in "${add_raws[@]+"${add_raws[@]}"}"; do
		dots_resolve_capability_selector "${s}" 0 >/dev/null || {
			dots_resolve_capability_selector "${s}" 0 || true
			return 1
		}
		if [[ ${DOTS_SEL_KIND} == "component" ]]; then
			dots_require_explicit_component_supported "${DOTS_SEL_ID}" || return 1
		fi
		dots_require_selector_installable || return 1
		resolved_adds+=("${DOTS_SEL_OWNER}")
	done
	for s in "${rem_raws[@]+"${rem_raws[@]}"}"; do
		dots_resolve_capability_selector "${s}" 0 >/dev/null || {
			dots_resolve_capability_selector "${s}" 0 || true
			return 1
		}
		resolved_rems+=("${DOTS_SEL_OWNER}")
	done
	local pkg
	for pkg in "${add_pkgs[@]+"${add_pkgs[@]}"}"; do
		DOTS_SEL_KIND="package"
		DOTS_SEL_ID="${pkg}"
		DOTS_SEL_OWNER="package:${pkg}"
		DOTS_SEL_VIA_PKG=""
		dots_require_selector_installable || return 1
		resolved_adds+=("package:${pkg}")
	done
	for pkg in "${rem_pkgs[@]+"${rem_pkgs[@]}"}"; do
		resolved_rems+=("package:${pkg}")
	done

	dots_profile_edit_resolve_target "${profile_arg}" 0 || return 1

	# External change detection if caller provided expected hash of source/overlay
	if [[ -n ${expected_hash} ]]; then
		local check_file="${DOTS_PE_OVERLAY_FILE}"
		[[ -f ${check_file} ]] || check_file="${DOTS_PE_SOURCE_FILE}"
		local actual_hash=""
		actual_hash="$(dots_profile_file_hash "${check_file}" 2>/dev/null || true)"
		if [[ -n ${actual_hash} && ${actual_hash} != "${expected_hash}" ]]; then
			echo "Error: profile changed on disk outside this session (expected ${expected_hash}, found ${actual_hash}). Refresh before saving." >&2
			return 1
		fi
	fi

	local adds_nl="" rems_nl=""
	[[ ${#resolved_adds[@]} -gt 0 ]] && adds_nl="$(printf '%s\n' "${resolved_adds[@]}")"
	[[ ${#resolved_rems[@]} -gt 0 ]] && rems_nl="$(printf '%s\n' "${resolved_rems[@]}")"

	local tmp_toml tmp_diff
	tmp_toml="$(mktemp "${TMPDIR:-/tmp}/dots-pmut-toml.XXXXXX")"
	tmp_diff="$(mktemp "${TMPDIR:-/tmp}/dots-pmut-diff.XXXXXX")"
	if ! dots_profile_edit_compute_batch "${DOTS_PE_SOURCE_FILE}" "${DOTS_PE_OVERLAY_FILE}" \
		"${DOTS_PE_OVERLAY_NAME}" "${DOTS_PE_EXTENDS_VAL}" \
		"${adds_nl}" "${rems_nl}" "${tmp_toml}" "${tmp_diff}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi

	if [[ ${DOTS_PE_CHANGED} -eq 0 ]]; then
		echo "${DOTS_PE_STATUS_MSG}"
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	cat "${tmp_diff}"
	if [[ ${dry} -eq 1 ]]; then
		echo ""
		echo "[dry-run] Would write overlay: ${DOTS_PE_OVERLAY_FILE}"
		[[ ${apply} -eq 1 ]] && echo "[dry-run] Would apply: ./bootstrap.sh --profile ${DOTS_PE_OVERLAY_FILE}"
		echo "[dry-run] No files modified."
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 0
	fi

	if [[ ${yes} -ne 1 ]] && [[ ${DOTS_UI_NONINTERACTIVE:-0} -ne 1 ]] && { [[ -t 0 ]] || [[ -n ${DOTS_UI_ANSWERS:-} ]]; }; then
		[[ -z ${DOTS_UI_ANSWER_FD:-} ]] && dots_ui_load_answers
		local ans
		ans="$(dots_prompt_yesno "Write batch profile changes" y)" || {
			rm -f "${tmp_toml}" "${tmp_diff}"
			echo "Aborted. No changes made."
			return 0
		}
		if [[ ${ans} != y ]]; then
			rm -f "${tmp_toml}" "${tmp_diff}"
			echo "Aborted. No changes made."
			return 0
		fi
	fi

	if ! dots_profile_edit_commit_atomic "${DOTS_PE_OVERLAY_FILE}" "${tmp_toml}"; then
		rm -f "${tmp_toml}" "${tmp_diff}"
		return 1
	fi
	rm -f "${tmp_toml}" "${tmp_diff}"

	echo "OK: updated ${DOTS_PE_OVERLAY_FILE} (active: ${DOTS_PE_OVERLAY_NAME})"
	[[ ${#resolved_rems[@]} -gt 0 ]] && echo "Note: removing desired state does not uninstall already-installed packages."

	if [[ ${apply} -eq 1 ]]; then
		local boot_bin="${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}"
		if ! "${boot_bin}" --profile "${DOTS_PE_OVERLAY_FILE}"; then
			echo "Desired state updated successfully. Machine convergence failed." >&2
			echo "Retry: ./dots profile apply" >&2
			return 1
		fi
	else
		echo "Apply later: ./dots profile apply"
	fi
	return 0
}

dots_cmd_profile() {
	local sub="${1:-}"
	if [[ $# -gt 0 ]]; then
		shift
	fi

	case "${sub}" in
	-h | --help | help)
		cat <<'EOF'
Usage:
  ./dots profile                             Interactive profile menu (TTY) or show
  ./dots profile list [--json]               List builtin, custom, and overlay profiles
  ./dots profile show [PROFILE] [--json]     Show resolved profile (read-only)
  ./dots profile plan [options] --json       Preview delta impact without mutating
  ./dots profile resolve SELECTOR --json     Resolve capability/package owner
  ./dots profile add SELECTOR [options]      Persist capability into sparse overlay
  ./dots profile remove SELECTOR [options]   Remove capability from desired state (no uninstall)
  ./dots profile mutate [options]            Atomic batch add/remove into sparse overlay
  ./dots profile diff [PROFILE]              Show local overlay additions/removals
  ./dots profile apply [PROFILE] [--dry-run] Converge machine toward profile
  ./dots profile create [configure.sh args]  Create/edit profile TOML via configure.sh
  ./dots profile switch PROFILE [--apply]    Switch active profile pointer

Options for add/remove/mutate:
  --profile NAME|PATH   Target profile (default: active profile)
  --apply               Converge via bootstrap.sh after updating profile
  --dry-run             Preview diff without writing files
  --yes, -y             Skip confirmation prompt
EOF
		return 0
		;;
	list)
		if [[ ${1:-} == --json ]]; then
			dots_profile_list_json
		else
			local ljson
			ljson="$(dots_profile_list_json)" || return 1
			JSON_IN="${ljson}" "${DOTS_PYTHON:-python3}" -B - <<'PY'
import json, os
data = json.loads(os.environ["JSON_IN"])
for p in data.get("profiles") or []:
    mark = "*" if p.get("active") else " "
    ext = f" -> {p['extends']}" if p.get("extends") else ""
    print(f"{mark} {p['name']:<18} [{p['kind']}] {p['file']}{ext}")
PY
		fi
		return $?
		;;
	show)
		local p="" json=0
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--json) json=1 ;;
			--profile)
				p="${2:-}"
				shift || true
				;;
			--profile=*) p="${1#*=}" ;;
			-*)
				echo "Error: unknown profile show option: $1" >&2
				return 1
				;;
			*) p="$1" ;;
			esac
			shift
		done
		if [[ ${json} -eq 1 ]]; then
			dots_profile_show_json "${p}"
			return $?
		fi
		if [[ -z ${p} ]]; then
			if dots_state_load_active 2>/dev/null; then
				p="${DOTS_ACTIVE_PROFILE_FILE:-${DOTS_ACTIVE_PROFILE}}"
			else
				echo "No active profile recorded. Preview a builtin with: ./dots profile show home" >&2
				return 1
			fi
		fi
		local pf
		pf="$(dots_resolve_profile_path "${p}")" || return 1
		"${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}" --profile "${pf}" --show
		return $?
		;;
	plan)
		local p="" json=0
		local -a add_sels=() rem_sels=() add_pkgs=() rem_pkgs=()
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--json) json=1 ;;
			--profile)
				p="${2:-}"
				shift || true
				;;
			--profile=*) p="${1#*=}" ;;
			--add)
				add_sels+=("${2:-}")
				shift || true
				;;
			--add=*) add_sels+=("${1#*=}") ;;
			--remove)
				rem_sels+=("${2:-}")
				shift || true
				;;
			--remove=*) rem_sels+=("${1#*=}") ;;
			--add-package)
				add_pkgs+=("${2:-}")
				shift || true
				;;
			--add-package=*) add_pkgs+=("${1#*=}") ;;
			--remove-package)
				rem_pkgs+=("${2:-}")
				shift || true
				;;
			--remove-package=*) rem_pkgs+=("${1#*=}") ;;
			-h | --help)
				echo "Usage: ./dots profile plan [--profile NAME] [--add SEL]... [--remove SEL]... [--add-package PKG]... [--remove-package PKG]... [--json]"
				return 0
				;;
			*)
				echo "Error: unknown profile plan option: $1" >&2
				return 1
				;;
			esac
			shift
		done
		local -a r_adds=() r_rems=()
		local s
		for s in "${add_sels[@]+"${add_sels[@]}"}"; do
			[[ -z ${s} ]] && continue
			dots_resolve_capability_selector "${s}" 0 >/dev/null || {
				dots_resolve_capability_selector "${s}" 0 || true
				return 1
			}
			r_adds+=("${DOTS_SEL_OWNER}")
		done
		for s in "${rem_sels[@]+"${rem_sels[@]}"}"; do
			[[ -z ${s} ]] && continue
			dots_resolve_capability_selector "${s}" 0 >/dev/null || {
				dots_resolve_capability_selector "${s}" 0 || true
				return 1
			}
			r_rems+=("${DOTS_SEL_OWNER}")
		done
		local pkg
		for pkg in "${add_pkgs[@]+"${add_pkgs[@]}"}"; do
			[[ -z ${pkg} ]] && continue
			DOTS_SEL_KIND="package"
			DOTS_SEL_ID="${pkg}"
			DOTS_SEL_OWNER="package:${pkg}"
			dots_require_selector_installable || return 1
			r_adds+=("package:${pkg}")
		done
		for pkg in "${rem_pkgs[@]+"${rem_pkgs[@]}"}"; do
			[[ -z ${pkg} ]] && continue
			r_rems+=("package:${pkg}")
		done
		local adds_nl="" rems_nl=""
		[[ ${#r_adds[@]} -gt 0 ]] && adds_nl="$(printf '%s\n' "${r_adds[@]}")"
		[[ ${#r_rems[@]} -gt 0 ]] && rems_nl="$(printf '%s\n' "${r_rems[@]}")"
		if [[ ${json} -eq 1 ]]; then
			dots_profile_plan_json "${p}" "${adds_nl}" "${rems_nl}"
			return $?
		fi
		dots_packages_plan ${p:+--profile "${p}"}
		return $?
		;;
	resolve)
		local sel="" json=0
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--json) json=1 ;;
			*) sel="$1" ;;
			esac
			shift
		done
		[[ -n ${sel} ]] || {
			echo "Usage: ./dots profile resolve SELECTOR [--json]" >&2
			return 1
		}
		if [[ ${json} -eq 1 ]]; then
			dots_profile_resolve_json "${sel}"
			return $?
		fi
		dots_resolve_capability_selector "${sel}" 0 && echo "${DOTS_SEL_OWNER}"
		return $?
		;;
	mutate)
		_dots_profile_mutate_subcmd "$@"
		return $?
		;;
	add)
		_dots_profile_edit_subcmd add "$@"
		return $?
		;;
	add-package)
		_dots_profile_package_subcmd add "$@"
		return $?
		;;
	remove)
		_dots_profile_edit_subcmd remove "$@"
		return $?
		;;
	remove-package)
		_dots_profile_package_subcmd remove "$@"
		return $?
		;;
	diff)
		dots_profile_show_diff "${1:-}"
		return $?
		;;
	apply)
		local target="" dry=0
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--dry-run) dry=1 ;;
			-h | --help)
				echo "Usage: ./dots profile apply [PROFILE] [--dry-run]"
				return 0
				;;
			-*)
				echo "Unknown profile apply option: $1" >&2
				return 1
				;;
			*) target="$1" ;;
			esac
			shift
		done
		if [[ -z ${target} ]]; then
			if dots_state_load_active 2>/dev/null; then
				target="${DOTS_ACTIVE_PROFILE_FILE:-${DOTS_ACTIVE_PROFILE}}"
			else
				echo "Error: no active profile recorded; pass profile name or path." >&2
				return 1
			fi
		fi
		local pf
		pf="$(dots_resolve_profile_path "${target}")" || return 1
		local args=(--profile "${pf}")
		[[ ${dry} -eq 1 ]] && args+=(--dry-run)
		"${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}" "${args[@]}"
		return $?
		;;
	create)
		exec "${DIR}/configure.sh" "$@"
		;;
	switch)
		local target="" apply=0 dry=0
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--apply) apply=1 ;;
			--dry-run) dry=1 ;;
			-h | --help)
				echo "Usage: ./dots profile switch PROFILE [--apply] [--dry-run]"
				return 0
				;;
			-*)
				echo "Unknown profile switch option: $1" >&2
				return 1
				;;
			*) target="$1" ;;
			esac
			shift
		done
		[[ -n ${target} ]] || {
			echo "Usage: ./dots profile switch PROFILE [--apply] [--dry-run]" >&2
			return 1
		}
		local pf
		pf="$(dots_resolve_profile_path "${target}")" || return 1
		dots_profile_parse "${pf}" >/dev/null || return 1
		if [[ ${dry} -eq 1 ]]; then
			echo "[dry-run] Would switch active profile to ${pf}"
			[[ ${apply} -eq 1 ]] && echo "[dry-run] Would run: ./bootstrap.sh --profile ${pf}"
			return 0
		fi
		dots_profile_write_active_marker "${pf}" || return 1
		echo "OK: active profile switched to ${pf}"
		if [[ ${apply} -eq 1 ]]; then
			"${DOTS_BOOTSTRAP_SH:-${DIR}/bootstrap.sh}" --profile "${pf}"
		else
			echo "Apply later: ./dots profile apply"
		fi
		return 0
		;;
	"")
		if [[ ${DOTS_UI_NONINTERACTIVE:-0} -eq 1 ]] || { [[ ! -t 0 ]] && [[ -z ${DOTS_UI_ANSWERS:-} ]]; }; then
			dots_cmd_profile show
			return $?
		fi
		;;
	*)
		# Backward-compatible: if someone passes a profile name directly (e.g. from completions)
		if dots_resolve_profile_path "${sub}" >/dev/null 2>&1; then
			dots_cmd_profile show "${sub}"
			return $?
		fi
		echo "Unknown profile subcommand: ${sub}" >&2
		echo "Try: ./dots profile --help" >&2
		return 1
		;;
	esac

	# Interactive menu
	dots_ui_load_answers
	while true; do
		dots_ui_header "DOTS Profile"
		local cur_name="(none)" cur_ext="" cur_file=""
		if dots_state_load_active 2>/dev/null; then
			cur_name="${DOTS_ACTIVE_PROFILE:-unknown}"
			cur_file="${DOTS_ACTIVE_PROFILE_FILE:-}"
			if [[ -n ${cur_file} && -f ${cur_file} ]]; then
				cur_ext="$(dots_profile_parse "${cur_file}" 2>/dev/null | sed -n 's/^extends://p' | head -n 1 || true)"
			fi
		fi
		echo ""
		echo "Current:"
		if [[ -n ${cur_ext} ]]; then
			echo "  ${cur_name} → ${cur_ext}"
		else
			echo "  ${cur_name}"
		fi
		echo ""
		echo "  1) Show resolved profile"
		echo "  2) Add software/capability"
		echo "  3) Remove capability"
		echo "  4) Show local overrides"
		echo "  5) Preview package plan"
		echo "  6) Apply current profile"
		echo "  7) Create profile"
		echo "  8) Switch profile"
		echo "  9) Show inheritance/source chain"
		echo "  q) Back"
		echo ""
		local c
		c="$(dots_ui_read_line "Choice" "1")" || return 0
		case "${c}" in
		1)
			dots_cmd_profile show || true
			;;
		2)
			local sel
			sel="$(dots_prompt_text "Capability, group, component, or package to add" "")" || continue
			[[ -n ${sel} ]] && { _dots_profile_edit_subcmd add "${sel}" || true; }
			;;
		3)
			local sel
			sel="$(dots_prompt_text "Capability, group, component, or package to remove" "")" || continue
			[[ -n ${sel} ]] && { _dots_profile_edit_subcmd remove "${sel}" || true; }
			;;
		4)
			dots_cmd_profile diff || true
			;;
		5)
			dots_packages_plan || true
			;;
		6)
			dots_cmd_profile apply || true
			;;
		7)
			"${DIR}/configure.sh" || true
			;;
		8)
			local p
			p="$(dots_prompt_text "Profile name or path" "home")" || continue
			[[ -n ${p} ]] && { dots_cmd_profile switch "${p}" || true; }
			;;
		9)
			if [[ -n ${cur_file} && -f ${cur_file} ]]; then
				dots_profile_parse "${cur_file}" | sed -n 's/^chain:/  -> /p'
			else
				dots_cmd_profile show || true
			fi
			;;
		q | Q | 0 | b | B)
			return 0
			;;
		*)
			echo "Enter 1-9 or q." >&2
			;;
		esac
	done
}

