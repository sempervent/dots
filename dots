		sub="${1:-status}"
		shift || true
		exec "${DIR}/scripts/ci/infra_validate.sh" "${sub}" "$@"
		;;
	-h | --help)
		cat <<'EOF'
Usage:
  ./dots check [--profile NAME|path]   Machine health (profile contract)
  ./dots check fast                    Local CI validators (workflows/docs/Docker)
  ./dots check workflows               actionlint + zizmor
  ./dots check docs [--offline|status|render|gate]
                                       Docs lint + Vale + links + diagram/publish stages
  ./dots check all-local               fast + full docs links + pre-commit
  ./dots check act [list|JOB]          Local GitHub Actions via act (no secrets)
  ./dots check release-notes           git-cliff preview (stdout only)
  ./dots check security [gate|status|secrets|sbom|verify…]
                                       Local supply-chain / secrets gate
  ./dots check containers [gate|status]
                                       OCI/container CLIs + static Dockerfile/Compose
  ./dots check k8s [gate|status]       Kubernetes CLIs + local manifest validation
  ./dots check dev [status|repo]       Developer tooling diagnostics (non-mutating)
  ./dots check data [status|examples]  PostgreSQL / tabular tooling (no DB connections)
  ./dots check geo [status|gate|examples]
                                       Geospatial tooling (no OSM download / DB / QGIS launch)
  ./dots check media [status|gate|examples]
                                       Media CLIs + Darwin app inventory (no capture/download/launch)
  ./dots check backup [status|examples]
                                       Backup/sync tooling (no repo init / no remotes)
  ./dots check network [status|examples]
                                       Network tooling (no scans/captures/Tailscale up)
  ./dots check hardware [status|examples]
                                       Hardware tooling (no SMART/fio/serial I/O)
  ./dots check infra [status|gate|examples]
                                       IaC tooling (no init/apply/login/build/API)

Local validators require package group `dev` (e.g. ./setup.sh --profile work).
Docs publishing CLIs require package group `docs`. Domain checks require their
package groups. They never install packages, start runtimes, create clusters, open
databases, initialize backup repositories, contact remotes, start Syncthing, scan
networks, capture packets, join Tailscale, benchmark disks, open serial devices,
apply/destroy infrastructure, login to Vault, build images, call Infracost APIs,
download browsers during docs checks, publish documentation, download OSM data,
run osm2pgsql imports, launch QGIS, serve PMTiles, capture mic/camera/screen,
download media via yt-dlp, launch desktop GUIs, or require a YubiKey.
EOF
		return 0
		;;
	esac

	local profile=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile)
			profile="${2:-}"
			shift
			;;
