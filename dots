dots_cmd_components() {
	local sub="${1:-}"
	shift || true

	if [[ -z ${sub} ]] && [[ -t 0 ]] && [[ -t 1 ]]; then
		dots_ui_header "DOTS Components"
		echo ""
		echo "  1) list      registry + host compatibility"
		echo "  2) active    last-selected (informational)"
		echo "  3) show      detail for one id"
		echo "  q) quit"
		echo ""
		local choice
		choice="$(dots_prompt_text "Choice" "1")"
		case "${choice}" in
		1 | list | l) sub=list ;;
		2 | active | a) sub=active ;;
		3 | show | s)
			sub=show
			set -- "$(dots_prompt_text "Component id" "")"
			;;
		q | quit | Q) return 0 ;;
		*) sub=list ;;
		esac
	elif [[ -z ${sub} ]]; then
		sub=list
	fi

	case "${sub}" in
	list | ls)
		local json=0 profile_arg=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--json) json=1 ;;
			--profile)
				profile_arg="${2:-}"
				shift || true
				;;
			--profile=*) profile_arg="${1#*=}" ;;
			esac
			shift
		done
		if [[ ${json} -eq 1 ]]; then
			dots_components_list_json "${profile_arg}"
		else
			dots_components_list
		fi
		;;
	active)
		dots_components_active
		;;
	show)
		local id="${1:-}"
		if [[ -z ${id} || ${id} == -h || ${id} == --help ]]; then
			echo "Usage: ./dots components show ID"
			return 0
		fi
		dots_components_show "${id}"
		;;
	-h | --help | help)
		cat <<EOF
Usage:
  ./dots components              interactive menu (TTY) or list
  ./dots components list         components + supergroups (host compat)
  ./dots components active       profile / groups / components (informational)
  ./dots components show ID      detail (Brewfile tokens, skills, members)

Optional components are selected via profile with= or:
  ./dots setup --with <ids>   ./setup.sh --with <ids>

Active inventory is INFORMATIONAL only — not AI consent.
Docs: https://sempervent.github.io/dots/using/components/
EOF
		;;
	*)
		echo "Unknown components subcommand: ${sub}" >&2
		echo "Try: ./dots components help" >&2
		return 1
		;;
	esac
}

dots_cmd_agent() {
	local helper="${DIR}/scripts/dots-agent"
	if [[ ! -x ${helper} ]]; then
		chmod +x "${helper}" 2>/dev/null || true
	fi
	if [[ ! -x ${helper} ]]; then
		echo "Error: missing ${helper}" >&2
		echo "       Run: ./dots setup --with pi" >&2
		return 1
	fi
	if [[ $# -eq 0 ]]; then
		cat <<'EOF'
DOTS Agent Harness

  ./dots agent status          Local executor / gateway / sandbox policy
  ./dots agent doctor          Diagnostics (SET/UNSET; sandbox FAIL/WARN/OK)
  ./dots agent sandbox status  Sandbox provider / backends / MCP allowlist
  ./dots agent models          Local + remote routing summary
  ./dots agent scout …         Cheapest qualifying OpenRouter model
  ./dots agent run …           Safe sandboxed task (default); --unsafe-host to bypass
  ./dots agent worktrees       List isolated agent worktrees
  ./dots agent mcp status      Trusted MCP allowlist
  ./dots agent costs           DOTS-recorded spend

Default runs are sandboxed (fail-closed). Explicit bypass: --unsafe-host
EOF
		return 0
	fi
	exec "${helper}" "$@"
}

