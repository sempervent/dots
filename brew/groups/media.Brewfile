# brew/groups/media.Brewfile — image / audio / video / retrieval CLIs
#
# ffmpeg  — decode/transcode/mux (+ ffprobe); never capture devices during DOTS checks
# sox     — audio processing / synthetic signals; never play/rec during DOTS checks
# yt-dlp  — explicit retrieval frontend (may use ffmpeg when the user runs it);
#           DOTS never downloads media or reads browser cookies during setup/check
# imagemagick / exiftool — pre-existing image tooling (preserved)

brew "ffmpeg"
brew "imagemagick"
brew "exiftool"
brew "sox"
brew "yt-dlp"
