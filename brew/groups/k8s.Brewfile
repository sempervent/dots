# brew/groups/k8s.Brewfile — Kubernetes / GitOps operator CLIs
# Install-only. Never creates clusters, modifies kubeconfig/context/namespace,
# installs krew plugins, applies Helmfile, or logs into Argo CD.
# kubectx formula also provides kubens.

brew "kubernetes-cli"
brew "k9s"
brew "kubectx"
brew "stern"
brew "krew"
brew "kubeconform"
brew "kubescape"
brew "popeye"
brew "helmfile"
brew "argocd"
