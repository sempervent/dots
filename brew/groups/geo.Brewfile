# brew/groups/geo.Brewfile — geospatial CLI tooling
#
# GDAL (ogrinfo/ogr2ogr/gdalinfo) is the format/raster/vector foundation.
# tippecanoe → vector tiles / MBTiles; pmtiles → PMTiles archive CLI (complementary).
# osmium-tool → OSM PBF/XML inspection/filter/merge (never auto-downloads OSM).
# osm2pgsql → OSM→PostGIS ingestion capability (never auto-connects or imports).
#
# mapshaper is npm-only (no brew formula) — see helpers/mapshaper.sh.
# QGIS remains mactools cask (omit_from_all); never install QGIS from this group.

brew "gdal"
brew "tippecanoe"
brew "pmtiles"
brew "osmium-tool"
brew "osm2pgsql"
