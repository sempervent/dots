# Optional: ./setup.sh --with openrig
# OpenRig CLI is installed via npm (@openrig/cli) under fnm-managed Node.
# This Brewfile ensures the Node manager + tmux seat backend exist.
# Side effects (fnm Node converge, npm install, ABI check) live in helpers/openrig.sh.
# DOTS never installs nvm.

brew "fnm"
brew "tmux"
